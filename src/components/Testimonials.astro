---
// Testimonials.astro — Gallop Construction
// NOTE: Yeh SAMPLE testimonials hain. Site live karne se pehle har item mein
// asal client ka naam, designation, company aur unka apna feedback daalein.

type T = { quote: string; name: string; role: string; project: string; rating: number };

const row1: T[] = [
  {
    quote: "The team was professional from the first site visit to the final handover. Work was completed on schedule and the quality of the structure is excellent.",
    name: "Client Name",
    role: "Plant Manager, Company Name",
    project: "Industrial",
    rating: 5,
  },
  {
    quote: "Clear quotation, no hidden costs and regular progress updates. We always knew exactly where our project stood.",
    name: "Client Name",
    role: "Director, Company Name",
    project: "Commercial",
    rating: 5,
  },
  {
    quote: "Their safety standards on site were impressive. Every worker followed proper procedures and the site was always well organised.",
    name: "Client Name",
    role: "HSE Officer, Company Name",
    project: "Industrial",
    rating: 5,
  },
  {
    quote: "They built our home exactly as designed and handled every detail with care. Highly recommended for residential projects.",
    name: "Client Name",
    role: "Homeowner, City",
    project: "Residential",
    rating: 5,
  },
];

const row2: T[] = [
  {
    quote: "Tank fabrication and installation were done with precision. Pressure testing and documentation were all handled properly.",
    name: "Client Name",
    role: "Maintenance Head, Company Name",
    project: "Mechanical",
    rating: 5,
  },
  {
    quote: "Our pipeline insulation was completed quickly with minimal disruption to production. We noticed the energy savings soon after.",
    name: "Client Name",
    role: "Operations Manager, Company Name",
    project: "Insulation",
    rating: 5,
  },
  {
    quote: "Responsive, reliable and easy to work with. Any change we requested was handled quickly without affecting the timeline.",
    name: "Client Name",
    role: "Project Coordinator, Company Name",
    project: "Commercial",
    rating: 5,
  },
  {
    quote: "From excavation to finishing, one team managed everything. It saved us a lot of time coordinating different contractors.",
    name: "Client Name",
    role: "Owner, Company Name",
    project: "Civil",
    rating: 5,
  },
];

const stats = [
  { value: "50+",  label: "Projects Completed" },
  { value: "10+",  label: "Years Experience" },
  { value: "100%", label: "On-Time Delivery" },
  { value: "4.9/5", label: "Average Rating" },
];

const initials = (n: string) => n.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
---

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<section class="ts" id="testimonials">

  <div class="ts-bg" aria-hidden="true">
    <div class="ts-dots"></div>
    <div class="ts-orb ts-orb-1"></div>
    <div class="ts-orb ts-orb-2"></div>
  </div>

  <!-- Header -->
  <div class="ts-container ts-head">
    <div class="ts-eyebrow">
      <span class="ts-eyebrow-line"></span>
      Testimonials
      <span class="ts-eyebrow-line"></span>
    </div>
    <h2 class="ts-heading">
      What Our <span class="ts-accent">Clients Say</span>
    </h2>
    <p class="ts-sub">
      Our best advertisement is the trust of the people we build for. Here's what
      clients say about working with Gallop Construction.
    </p>
  </div>

  <!-- Row 1 → left -->
  <div class="ts-marquee">
    <div class="ts-track ts-left">
      {[...row1, ...row1].map((t, i) => (
        <article class="ts-card" aria-hidden={i >= row1.length ? 'true' : undefined}>
          <div class="ts-card-top">
            <svg class="ts-quote" viewBox="0 0 24 24" fill="currentColor"><path d="M9.6 6C6.5 7.4 4.5 10 4.5 13.4V18h6v-6H7.6c.2-1.9 1.4-3.4 3.2-4.3L9.6 6Zm9 0c-3.1 1.4-5.1 4-5.1 7.4V18h6v-6h-2.9c.2-1.9 1.4-3.4 3.2-4.3L18.6 6Z"/></svg>
            <span class="ts-tag">{t.project}</span>
          </div>

          <div class="ts-stars" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, s) => (
              <svg viewBox="0 0 24 24" class={s < t.rating ? 'on' : ''}><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
            ))}
          </div>

          <p class="ts-text">{t.quote}</p>

          <div class="ts-person">
            <span class="ts-avatar">{initials(t.name)}</span>
            <span>
              <span class="ts-name">{t.name}</span>
              <span class="ts-role">{t.role}</span>
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Row 2 → right -->
  <div class="ts-marquee">
    <div class="ts-track ts-right">
      {[...row2, ...row2].map((t, i) => (
        <article class="ts-card" aria-hidden={i >= row2.length ? 'true' : undefined}>
          <div class="ts-card-top">
            <svg class="ts-quote" viewBox="0 0 24 24" fill="currentColor"><path d="M9.6 6C6.5 7.4 4.5 10 4.5 13.4V18h6v-6H7.6c.2-1.9 1.4-3.4 3.2-4.3L9.6 6Zm9 0c-3.1 1.4-5.1 4-5.1 7.4V18h6v-6h-2.9c.2-1.9 1.4-3.4 3.2-4.3L18.6 6Z"/></svg>
            <span class="ts-tag">{t.project}</span>
          </div>

          <div class="ts-stars" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, s) => (
              <svg viewBox="0 0 24 24" class={s < t.rating ? 'on' : ''}><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
            ))}
          </div>

          <p class="ts-text">{t.quote}</p>

          <div class="ts-person">
            <span class="ts-avatar">{initials(t.name)}</span>
            <span>
              <span class="ts-name">{t.name}</span>
              <span class="ts-role">{t.role}</span>
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Stats -->
  <div class="ts-container">
    <div class="ts-stats">
      {stats.map((s) => (
        <div class="ts-stat">
          <span class="ts-stat-val">{s.value}</span>
          <span class="ts-stat-lbl">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ts {
    --blue: #1d6ff2;
    --blue-soft: #eaf2ff;
    --navy: #0f2a5c;
    --text: #5b6b85;
    --line: #e2eaf6;
    --bg-edge: #f3f7fd;
    position: relative;
    width: 100%;
    padding: 6.5rem 0 5.5rem;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #ffffff 0%, var(--bg-edge) 100%);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: var(--navy);
  }

  /* ── Background ── */
  .ts-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .ts-dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(29,111,242,0.12) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 55%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 55%);
  }
  .ts-orb { position: absolute; border-radius: 50%; filter: blur(100px); animation: tsFloat 18s ease-in-out infinite alternate; }
  .ts-orb-1 { width: 420px; height: 420px; background: rgba(29,111,242,0.12); top: 10%; left: -160px; }
  .ts-orb-2 { width: 380px; height: 380px; background: rgba(14,165,233,0.10); bottom: 0; right: -140px; animation-delay: -9s; }
  @keyframes tsFloat { to { transform: translate(60px, -40px); } }

  .ts-container { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

  /* ── Header ── */
  .ts-head { text-align: center; max-width: 720px; margin-bottom: 3rem; }
  .ts-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 0.9rem;
  }
  .ts-eyebrow-line { width: 30px; height: 3px; border-radius: 2px; background: var(--blue); }
  .ts-heading {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800; line-height: 1.1; letter-spacing: -0.02em;
    color: var(--navy) !important;
  }
  .ts-heading :global(*) { color: inherit; }
  .ts-heading .ts-accent, .ts-heading :global(.ts-accent) { color: var(--blue) !important; }
  .ts-sub { margin: 0 auto; max-width: 560px; font-size: 1.02rem; line-height: 1.7; color: var(--text); }

  /* ── Marquee ── */
  .ts-marquee {
    position: relative;
    overflow: hidden;
    padding: 0.8rem 0;
    mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }
  .ts-track { display: flex; gap: 1.4rem; width: max-content; padding: 0.4rem 0; }
  .ts-left  { animation: tsLeft 55s linear infinite; }
  .ts-right { animation: tsRight 55s linear infinite; }
  .ts-marquee:hover .ts-track { animation-play-state: paused; }
  @keyframes tsLeft  { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 0.7rem)); } }
  @keyframes tsRight { from { transform: translateX(calc(-50% - 0.7rem)); } to { transform: translateX(0); } }

  /* ── Card ── */
  .ts-card {
    flex-shrink: 0;
    width: 380px;
    display: flex; flex-direction: column;
    padding: 1.6rem 1.6rem 1.4rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 10px 28px rgba(15,42,92,0.06);
    transition: transform 0.35s cubic-bezier(.22,1,.36,1), box-shadow 0.35s, border-color 0.35s;
  }
  .ts-card:hover {
    transform: translateY(-6px);
    border-color: rgba(29,111,242,0.30);
    box-shadow: 0 22px 44px rgba(15,42,92,0.12);
  }
  .ts-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
  .ts-quote { width: 38px; height: 38px; color: var(--blue); opacity: 0.9; }
  .ts-tag {
    padding: 5px 12px; border-radius: 999px;
    background: var(--blue-soft); color: var(--blue);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }

  .ts-stars { display: flex; gap: 3px; margin-bottom: 0.8rem; }
  .ts-stars svg { width: 16px; height: 16px; fill: #d6e2f3; }
  .ts-stars svg.on { fill: #f5b301; }

  .ts-text {
    flex: 1;
    margin: 0 0 1.3rem;
    font-size: 0.95rem; line-height: 1.7;
    color: #34476b;
  }

  .ts-person {
    display: flex; align-items: center; gap: 12px;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--line);
  }
  .ts-avatar {
    width: 46px; height: 46px; flex-shrink: 0;
    border-radius: 50%;
    display: grid; place-items: center;
    background: linear-gradient(150deg, #2b7cff, #1257d6);
    color: #fff; font-size: 0.9rem; font-weight: 800;
    box-shadow: 0 6px 14px rgba(29,111,242,0.30);
  }
  .ts-name { display: block; font-size: 0.98rem; font-weight: 700; color: var(--navy); }
  .ts-role { display: block; margin-top: 2px; font-size: 0.8rem; color: var(--text); }

  /* ── Stats ── */
  .ts-stats {
    margin-top: 3rem;
    display: grid; grid-template-columns: repeat(4, 1fr);
    padding: 1.8rem 1rem;
    border-radius: 22px;
    background: linear-gradient(120deg, #0f2a5c 0%, #123a80 55%, #1d6ff2 100%);
    box-shadow: 0 20px 44px rgba(15,42,92,0.22);
  }
  .ts-stat {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    border-right: 1px solid rgba(255,255,255,0.15);
  }
  .ts-stat:last-child { border-right: none; }
  .ts-stat-val { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; line-height: 1; color: #fff; }
  .ts-stat-lbl { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.72); text-align: center; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .ts { padding: 4.5rem 0 4rem; }
    .ts-card { width: 300px; padding: 1.3rem; }
    .ts-stats { grid-template-columns: repeat(2, 1fr); row-gap: 1.5rem; }
    .ts-stat:nth-child(2) { border-right: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ts-track, .ts-orb { animation: none; }
  }
</style>