---
import { Image } from 'astro:assets';
import featuresdiagonal from '../assets/images/featuresdiagonal.jpg';

const values = [
  { title: 'Safety First', text: 'Strict site safety on every project.', icon: 'shield' },
  { title: 'Quality Build', text: 'Premium materials, tested standards.', icon: 'star' },
  { title: 'On-Time', text: 'Clear timelines, delivered as promised.', icon: 'clock' },
];
---

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<section id="mission" class="mv">

  <!-- Soft animated background -->
  <div class="mv-bg" aria-hidden="true">
    <div class="mv-dots"></div>
    <div class="mv-orb mv-orb-1"></div>
    <div class="mv-orb mv-orb-2"></div>
  </div>

  <div class="mv-container">

    <!-- LEFT: Image -->
    <div class="mv-visual" data-gsap="scale-in">
      <div class="mv-frame">
        <Image src={featuresdiagonal} alt="Gallop Construction project in progress" class="mv-img" />
        <div class="mv-img-shade"></div>
      </div>

      <!-- Floating experience card -->
      <div class="mv-exp">
        <span class="mv-exp-num">10+</span>
        <span class="mv-exp-lbl">Years of<br />Building Trust</span>
      </div>

      <!-- Floating badge -->
      <div class="mv-badge">
        <div class="mv-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div>
          <p class="mv-badge-title">Licensed &amp; Insured</p>
          <p class="mv-badge-sub">Certified quality standards</p>
        </div>
      </div>

      <div class="mv-corner" aria-hidden="true"></div>
    </div>

    <!-- RIGHT: Content -->
    <div class="mv-content">
      <div class="mv-eyebrow" data-gsap="fade-left">
        <span class="mv-eyebrow-line"></span>
        Our Purpose
      </div>

      <h2 class="mv-heading" data-gsap="fade-up">
        Mission &amp; <span class="mv-accent">Vision</span>
      </h2>

      <p class="mv-intro" data-gsap="fade-up">
        At Gallop Construction, every project is a promise — built with integrity,
        delivered with precision and designed to last for generations.
      </p>

      <!-- Mission / Vision cards -->
      <div class="mv-cards" data-gsap="stagger">
        <div class="mv-card" data-gsap-item>
          <div class="mv-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>
          </div>
          <div>
            <h3 class="mv-card-title">Our Mission</h3>
            <p class="mv-card-text">
              To deliver residential, commercial and industrial projects of the highest
              quality — safely, on time and within budget — while building lasting
              relationships with every client.
            </p>
          </div>
        </div>

        <div class="mv-card" data-gsap-item>
          <div class="mv-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div>
            <h3 class="mv-card-title">Our Vision</h3>
            <p class="mv-card-text">
              To be the most trusted name in construction, known for modern techniques,
              a skilled workforce and structures that set new standards in every city we build.
            </p>
          </div>
        </div>
      </div>

      <!-- Values -->
      <div class="mv-values" data-gsap="stagger">
        {values.map((v) => (
          <div class="mv-value" data-gsap-item>
            <span class="mv-value-icon">
              {v.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              )}
              {v.icon === 'star' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
              )}
              {v.icon === 'clock' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              )}
            </span>
            <div>
              <p class="mv-value-title">{v.title}</p>
              <p class="mv-value-text">{v.text}</p>
            </div>
          </div>
        ))}
      </div>

      <a href="/contact" class="mv-btn" data-gsap="fade-up">
        Get Started
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .mv {
    --blue: #f5a623;
    --blue-soft: rgba(245,166,35,0.12);
    --navy: #ffffff;
    --text: #aab4c3;
    --line: #263040;
    position: relative;
    width: 100%;
    padding: 6.5rem 1.5rem;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #161d27 0%, #10151c 100%);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: var(--navy);
  }

  /* ── Background ── */
  .mv-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .mv-dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(245,166,35,0.14) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 70%);
  }
  .mv-orb {
    position: absolute; border-radius: 50%;
    filter: blur(100px);
    animation: mvFloat 18s ease-in-out infinite alternate;
  }
  .mv-orb-1 { width: 460px; height: 460px; background: rgba(245,166,35,0.16); top: -160px; left: -120px; }
  .mv-orb-2 { width: 380px; height: 380px; background: rgba(245,158,11,0.14); bottom: -140px; right: -100px; animation-delay: -8s; }
  @keyframes mvFloat {
    from { transform: translate(0, 0); }
    to   { transform: translate(60px, 50px); }
  }

  /* ── Layout ── */
  .mv-container {
    position: relative; z-index: 1;
    max-width: 1240px; margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: center;
  }

  /* ── Image side ── */
  .mv-visual { position: relative; padding: 0 0 2rem 2rem; }
  .mv-frame {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.54);
  }
  .mv-img {
    display: block;
    width: 100%; height: 560px;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(.22,1,.36,1);
  }
  .mv-frame:hover .mv-img { transform: scale(1.04); }
  .mv-img-shade {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,13,18,0.35), transparent 45%);
  }

  .mv-exp {
    position: absolute;
    top: 2.5rem; left: 0;
    display: flex; align-items: center; gap: 12px;
    padding: 1.1rem 1.4rem;
    border-radius: 16px;
    background: linear-gradient(150deg, #ffb84d, #d98a0b);
    color: #10151c;
    box-shadow: 0 16px 34px rgba(245,166,35,0.35);
    animation: mvBob 5s ease-in-out infinite;
  }
  .mv-exp-num { font-size: 2.2rem; font-weight: 800; line-height: 1; }
  .mv-exp-lbl { font-size: 0.8rem; font-weight: 600; line-height: 1.3; opacity: 0.92; }

  .mv-badge {
    position: absolute;
    bottom: 0; right: -1.5rem;
    display: flex; align-items: center; gap: 12px;
    padding: 1rem 1.3rem;
    min-width: 230px;
    border-radius: 16px;
    background: #161d27;
    border: 1px solid var(--line);
    box-shadow: 0 16px 34px rgba(0,0,0,0.36);
    animation: mvBob 5s ease-in-out infinite;
    animation-delay: -2.5s;
  }
  .mv-badge-icon {
    width: 44px; height: 44px; flex-shrink: 0;
    border-radius: 12px;
    background: var(--blue-soft);
    color: var(--blue);
    display: grid; place-items: center;
  }
  .mv-badge-icon svg { width: 22px; height: 22px; }
  .mv-badge-title { margin: 0; font-size: 0.92rem; font-weight: 700; color: var(--navy); }
  .mv-badge-sub { margin: 2px 0 0; font-size: 0.76rem; color: var(--blue); font-weight: 600; }

  @keyframes mvBob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  .mv-corner {
    position: absolute;
    top: -14px; right: -14px;
    width: 110px; height: 110px;
    border-top: 4px solid var(--blue);
    border-right: 4px solid var(--blue);
    border-radius: 0 26px 0 0;
    opacity: 0.6;
    pointer-events: none;
  }

  /* ── Content side ── */
  .mv-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.9rem;
  }
  .mv-eyebrow-line { width: 34px; height: 3px; border-radius: 2px; background: var(--blue); }

  .mv-heading {
    margin: 0 0 1.1rem;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--navy) !important;
  }
  .mv-heading :global(*) { color: inherit; }
  .mv-heading .mv-accent,
  .mv-heading :global(.mv-accent) { color: var(--blue) !important; }

  .mv-intro {
    margin: 0 0 2rem;
    max-width: 540px;
    font-size: 1.02rem; line-height: 1.7;
    color: var(--text);
  }

  .mv-cards { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.8rem; }
  .mv-card {
    display: flex; gap: 1.1rem;
    padding: 1.3rem 1.4rem;
    background: #161d27;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
  }
  .mv-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245,166,35,0.35);
    box-shadow: 0 16px 36px rgba(0,0,0,0.30);
  }
  .mv-card-icon {
    width: 52px; height: 52px; flex-shrink: 0;
    border-radius: 14px;
    background: var(--blue-soft);
    color: var(--blue);
    display: grid; place-items: center;
    transition: background 0.3s, color 0.3s;
  }
  .mv-card-icon svg { width: 26px; height: 26px; }
  .mv-card:hover .mv-card-icon { background: var(--blue); color: #10151c; }
  .mv-card-title { margin: 0.2rem 0 0.4rem; font-size: 1.1rem; font-weight: 700; color: var(--navy); }
  .mv-card-text { margin: 0; font-size: 0.92rem; line-height: 1.65; color: var(--text); }

  .mv-values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1.2rem 0 2rem;
    border-top: 1px solid var(--line);
  }
  .mv-value { display: flex; gap: 10px; align-items: flex-start; }
  .mv-value-icon {
    width: 34px; height: 34px; flex-shrink: 0;
    border-radius: 50%;
    background: var(--blue-soft);
    color: var(--blue);
    display: grid; place-items: center;
  }
  .mv-value-icon svg { width: 17px; height: 17px; }
  .mv-value-title { margin: 0; font-size: 0.9rem; font-weight: 700; color: var(--navy); }
  .mv-value-text { margin: 2px 0 0; font-size: 0.78rem; line-height: 1.45; color: var(--text); }

  .mv-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 30px;
    border-radius: 999px;
    background: var(--blue);
    color: #10151c !important;
    font-weight: 600; font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(245,166,35,0.30);
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .mv-btn:hover {
    background: #e0951a;
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(245,166,35,0.40);
  }
  .mv-btn svg { transition: transform 0.25s; }
  .mv-btn:hover svg { transform: translateX(4px); }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .mv-container { grid-template-columns: 1fr; gap: 4rem; }
    .mv-visual { max-width: 560px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 640px) {
    .mv { padding: 4.5rem 1.25rem; }
    .mv-visual { padding: 0 0 2rem 1rem; }
    .mv-img { height: 400px; }
    .mv-badge { right: 0; min-width: 0; }
    .mv-exp { padding: 0.8rem 1rem; }
    .mv-exp-num { font-size: 1.7rem; }
    .mv-corner { display: none; }
    .mv-values { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mv-orb, .mv-exp, .mv-badge { animation: none; }
  }
</style>