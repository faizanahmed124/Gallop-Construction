---
// ServicesSection.astro — Home page services (Gallop Construction)

const services = [
  {
    tag: "Civil",
    number: "01",
    title: "Civil Construction",
    subtitle: "Foundations, Structures & Site Works",
    description:
      "Complete civil works for homes, offices and factories — from excavation and RCC structures to masonry, finishing and external infrastructure, all built to approved drawings.",
    features: [
      "Excavation & Foundation Work",
      "RCC Structures & Concrete Work",
      "Brick Masonry & Plastering",
      "Roads, Drainage & Site Grading",
    ],
    badge: "Engineer Supervised",
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80",
    icon: `<path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/>`,
  },
  {
    tag: "Mechanical",
    number: "02",
    title: "Mechanical Works",
    subtitle: "Fabrication, Installation & Boilers",
    description:
      "Our trained fabricators build and install MS tanks, process vessels, boilers and steel structures — welded precisely, pressure-tested and commissioned safely.",
    features: [
      "MS Tank & Vessel Fabrication",
      "Plant Installation & Commissioning",
      "Industrial Boiler Services",
      "Structural Steel Erection",
    ],
    badge: "Skilled Fabricators",
    image: "https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=800&q=80",
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>`,
  },
  {
    tag: "Insulation",
    number: "03",
    title: "Insulation & Ducting",
    subtitle: "Thermal, Cold-Line & HVAC",
    description:
      "Cut energy loss and keep systems at safe temperatures with professional pipe insulation, HVAC ductwork and durable aluminium or GI cladding.",
    features: [
      "Steam & Hot-Water Pipe Insulation",
      "Cold-Line & Chilled-Water Insulation",
      "HVAC Duct Fabrication",
      "Aluminium & GI Cladding",
    ],
    badge: "Energy Efficient",
    image: "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=800&q=80",
    icon: `<rect x="2" y="4" width="20" height="16" rx="3"/><path d="M4 9h16M4 15h16"/>`,
  },
];
---

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<section class="sv" id="services">

  <div class="sv-bg" aria-hidden="true">
    <div class="sv-dots"></div>
    <div class="sv-orb sv-orb-1"></div>
    <div class="sv-orb sv-orb-2"></div>
  </div>

  <div class="sv-container">

    <!-- Header -->
    <div class="sv-head">
      <div class="sv-head-text">
        <div class="sv-eyebrow" data-gsap="fade-left">
          <span class="sv-eyebrow-line"></span>
          Our Services
        </div>
        <h2 class="sv-heading" data-gsap="fade-up">
          Everything Your Project Needs,<br />
          <span class="sv-accent">Delivered by One Team</span>
        </h2>
        <p class="sv-sub" data-gsap="fade-up">
          Civil works, mechanical fabrication and insulation under one contract — fewer
          vendors, clearer accountability and a project that stays on schedule.
        </p>
      </div>

      <a href="/services" class="sv-btn sv-btn-desktop">
        All Services
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <!-- Cards -->
    <div class="sv-grid" data-gsap="stagger">
      {services.map((s) => (
        <article class="sv-card" data-gsap-item>
          <div class="sv-media">
            <img src={s.image} alt={s.title} class="sv-img" loading="lazy" />
            <div class="sv-shade"></div>
            <span class="sv-tag"><span class="sv-tag-dot"></span>{s.tag}</span>
            <span class="sv-num">{s.number}</span>
          </div>

          <div class="sv-body">
            <div class="sv-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon}></svg>
            </div>

            <h3 class="sv-title">{s.title}</h3>
            <p class="sv-subtitle">{s.subtitle}</p>
            <p class="sv-desc">{s.description}</p>

            <ul class="sv-features">
              {s.features.map((f) => (
                <li>
                  <span class="sv-check">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  {f}
                </li>
              ))}
            </ul>

            <div class="sv-foot">
              <span class="sv-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                {s.badge}
              </span>
              <a href="/services" class="sv-more" aria-label={`Learn more about ${s.title}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="sv-mobile-cta">
      <a href="/services" class="sv-btn">
        View All Services
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .sv {
    --blue: #f5a623;
    --blue-soft: rgba(245,166,35,0.12);
    --navy: #ffffff;
    --text: #aab4c3;
    --line: #263040;
    position: relative;
    width: 100%;
    padding: 6.5rem 1.5rem;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #10151c 0%, #161d27 100%);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: var(--navy);
  }

  /* ── Background ── */
  .sv-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .sv-dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(245,166,35,0.13) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse at 85% 15%, #000 15%, transparent 55%);
    -webkit-mask-image: radial-gradient(ellipse at 85% 15%, #000 15%, transparent 55%);
  }
  .sv-orb { position: absolute; border-radius: 50%; filter: blur(100px); animation: svFloat 18s ease-in-out infinite alternate; }
  .sv-orb-1 { width: 420px; height: 420px; background: rgba(245,166,35,0.13); top: -160px; left: -120px; }
  .sv-orb-2 { width: 360px; height: 360px; background: rgba(245,158,11,0.11); bottom: -140px; right: -100px; animation-delay: -9s; }
  @keyframes svFloat { to { transform: translate(50px, 40px); } }

  .sv-container { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; }

  /* ── Header ── */
  .sv-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 2rem; margin-bottom: 3.2rem;
  }
  .sv-head-text { max-width: 640px; }
  .sv-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.9rem;
  }
  .sv-eyebrow-line { width: 34px; height: 3px; border-radius: 2px; background: var(--blue); }
  .sv-heading {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800; line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy) !important;
  }
  .sv-heading :global(*) { color: inherit; }
  .sv-heading .sv-accent,
  .sv-heading :global(.sv-accent) { color: var(--blue) !important; }
  .sv-sub { margin: 0; font-size: 1.02rem; line-height: 1.7; color: var(--text); }

  .sv-btn {
    position: relative; overflow: hidden;
    flex-shrink: 0;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 30px;
    border-radius: 999px;
    background: var(--blue);
    color: #10151c !important;
    font-weight: 600; font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(245,166,35,0.30);
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .sv-btn::before {
    content: ''; position: absolute; top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    transition: left 0.6s ease;
  }
  .sv-btn:hover::before { left: 100%; }
  .sv-btn:hover { background: #e0951a; transform: translateY(-2px); box-shadow: 0 14px 30px rgba(245,166,35,0.40); }
  .sv-btn svg { position: relative; transition: transform 0.25s; }
  .sv-btn:hover svg { transform: translateX(4px); }

  /* ── Grid ── */
  .sv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }

  .sv-card {
    display: flex; flex-direction: column;
    background: #161d27;
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.18);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1), box-shadow 0.4s, border-color 0.4s;
  }
  .sv-card:hover {
    transform: translateY(-8px);
    border-color: rgba(245,166,35,0.30);
    box-shadow: 0 26px 50px rgba(0,0,0,0.42);
  }

  .sv-media { position: relative; height: 220px; overflow: hidden; background: #263040; }
  .sv-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(.22,1,.36,1); }
  .sv-card:hover .sv-img { transform: scale(1.08); }
  .sv-shade {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,13,18,0.55) 0%, transparent 55%);
  }
  .sv-tag {
    position: absolute; top: 14px; left: 14px;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 13px;
    border-radius: 999px;
    background: rgba(22,29,39,0.94);
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue);
  }
  .sv-tag-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
  .sv-num {
    position: absolute; right: 16px; bottom: 10px;
    font-size: 2.6rem; font-weight: 800; line-height: 1;
    color: rgba(255,255,255,0.35);
  }

  .sv-body { position: relative; display: flex; flex: 1; flex-direction: column; padding: 0 1.6rem 1.5rem; }
  .sv-icon {
    width: 58px; height: 58px;
    margin-top: -29px; margin-bottom: 1rem;
    border-radius: 16px;
    background: linear-gradient(150deg, #ffb84d, #d98a0b);
    color: #10151c;
    display: grid; place-items: center;
    box-shadow: 0 0 0 5px #fff, 0 12px 26px rgba(245,166,35,0.30);
    position: relative; z-index: 1;
    transition: transform 0.4s cubic-bezier(.34,1.56,.64,1);
  }
  .sv-icon svg { width: 26px; height: 26px; }
  .sv-card:hover .sv-icon { transform: rotate(-8deg) scale(1.06); }

  .sv-title { margin: 0; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
  .sv-subtitle { margin: 4px 0 0.9rem; font-size: 0.86rem; font-weight: 600; color: var(--blue); }
  .sv-desc { margin: 0 0 1.2rem; font-size: 0.92rem; line-height: 1.7; color: var(--text); }

  .sv-features { list-style: none; margin: 0 0 1.4rem; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .sv-features li { display: flex; align-items: center; gap: 10px; font-size: 0.88rem; font-weight: 600; color: var(--navy); }
  .sv-check {
    flex-shrink: 0;
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--blue-soft); color: var(--blue);
    display: grid; place-items: center;
  }
  .sv-check svg { width: 11px; height: 11px; }

  .sv-foot {
    margin-top: auto;
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--line);
  }
  .sv-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 700; color: var(--blue); }
  .sv-badge svg { width: 18px; height: 18px; }
  .sv-more {
    width: 40px; height: 40px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--blue-soft); color: var(--blue);
    transition: background 0.3s, color 0.3s, transform 0.3s;
  }
  .sv-more svg { width: 17px; height: 17px; }
  .sv-card:hover .sv-more { background: var(--blue); color: #10151c; transform: rotate(45deg); }

  .sv-mobile-cta { display: none; margin-top: 2.5rem; justify-content: center; }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .sv-grid { grid-template-columns: repeat(2, 1fr); }
    .sv-btn-desktop { display: none; }
    .sv-mobile-cta { display: flex; }
  }
  @media (max-width: 680px) {
    .sv { padding: 4.5rem 1.25rem; }
    .sv-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-orb { animation: none; }
  }
</style>