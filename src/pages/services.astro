<script is:inline>
  (function () {
    function init() {
      // ── Gallery ──
      document.querySelectorAll('[data-gallery]').forEach(function (gallery) {
        var mainImg = gallery.querySelector('.gal-main-img');
        var thumbs = gallery.querySelectorAll('.gal-thumb');
        var counter = gallery.querySelector('.gal-count');
        var images = Array.prototype.map.call(thumbs, function (b) { return b.querySelector('img').src; });
        var cur = 0;

        function goTo(idx) {
          cur = (idx + images.length) % images.length;
          mainImg.style.opacity = '0';
          setTimeout(function () {
            mainImg.src = images[cur];
            mainImg.style.opacity = '';
          }, 220);
          thumbs.forEach(function (t, i) { t.classList.toggle('active', i === cur); });
          counter.textContent = (cur + 1) + ' / ' + images.length;
        }

        thumbs.forEach(function (btn, i) { btn.addEventListener('click', function () { goTo(i); }); });
        var prev = gallery.querySelector('[data-dir="prev"]');
        var next = gallery.querySelector('[data-dir="next"]');
        if (prev) prev.addEventListener('click', function () { goTo(cur - 1); });
        if (next) next.addEventListener('click', function () { goTo(cur + 1); });
      });

      // ── Filter tabs ──
      var tabs = document.querySelectorAll('.ftab');
      var rows = document.querySelectorAll('.svc-row');
      var empty = document.getElementById('emptyState');

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');
          var cat = tab.getAttribute('data-cat');
          var n = 0;
          rows.forEach(function (row) {
            var show = cat === 'All' || row.getAttribute('data-category') === cat;
            row.style.display = show ? '' : 'none';
            if (show) n++;
          });
          if (empty) empty.style.display = n === 0 ? 'block' : 'none';
        });
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>