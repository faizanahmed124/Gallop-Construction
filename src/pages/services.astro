---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';

const services = [
  {
    id: "01",
    title: "Civil Construction",
    subtitle: "Foundations, Structures & Site Development",
    category: "Civil",
    description:
      "From the first survey peg to the final coat of plaster, Gallop handles the complete civil scope of your project. Our site engineers and skilled crews deliver strong foundations, durable structures and clean finishes for residential, commercial and industrial buildings — built to approved drawings, safety codes and your timeline.",
    features: [
      "Excavation & Foundation Work",
      "RCC Structures & Concrete Work",
      "Structural Steel Erection",
      "Brick Masonry & Plastering",
      "Site Grading, Roads & Pavements",
      "Drainage & External Infrastructure",
    ],
    images: [
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRNWGuiHWPMmO3upn-EQQvxIE5RQEQOxixFmPjWMD0WoRfABLqQnpy8zqY&s=10",
      "https://i.pinimg.com/1200x/fb/8b/46/fb8b46f8ea9f3153604b58e811c05cf9.jpg",
      "https://i.pinimg.com/736x/bf/57/a7/bf57a7bcc7c60cdb7ff755861f47b33e.jpg",
      "/civilimages4.jpeg",
      "/civilimages5.jpeg",
    ],
    icon: `<path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/><path d="M9 10h.01M15 10h.01"/>`,
    accent: "#f5a623",
  },
  {
    id: "02",
    title: "Mechanical Works",
    subtitle: "MS Tank Fabrication, Installation & Boiler Services",
    category: "Mechanical",
    description:
      "Gallop's mechanical team fabricates, installs and commissions mild-steel tanks, process vessels and industrial boilers for factories and plants. Every weld is done by trained fabricators, every vessel is pressure-tested, and every installation is handed over with full documentation — so your plant runs safely from day one.",
    features: [
      "Custom MS Tank Fabrication",
      "Tank Installation & Commissioning",
      "Industrial Boiler Installation",
      "Boiler Maintenance & Overhauling",
      "MIG, TIG & Arc Welding",
      "Anti-Corrosion Coating",
      "Pressure Testing & Inspection",
      "On-Site Fabrication & Repair",
    ],
    images: [
      "/mechanical/mechanicalimages1.jpeg",
      "/mechanical/mechanicalimages2.jpeg",
      "/mechanical/mechanicalimages3.jpeg",
      "/mechanical/mechanicalimages4.jpeg",
      "/mechanical/mechanicalimages5.jpeg",
    ],
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>`,
    accent: "#f59e0b",
  },
  {
    id: "03",
    title: "Insulation & Ducting",
    subtitle: "Thermal, Cold-Line & HVAC Solutions",
    category: "Insulation",
    description:
      "Energy lost through bare pipes and leaky ducts is money lost every day. Gallop insulates steam, hot-water and chilled-water lines and fabricates HVAC ductwork that keeps your systems efficient, your temperatures stable and your workers safe — finished with neat, long-lasting cladding.",
    features: [
      "Steam & Hot-Water Pipe Insulation",
      "Cold-Line & Chilled-Water Insulation",
      "HVAC Duct Fabrication & Installation",
      "GI & Aluminium Cladding",
    ],
    images: [
      "/insulation/insulationimages1.jpeg",
      "/insulation/insulationimages2.jpeg",
      "/insulation/insulationimages3.jpeg",
      "/insulation/insulationimages4.jpeg",
      "/insulation/insulationimages5.jpeg",
    ],
    icon: `<path d="M4 7h16M4 12h16M4 17h16"/><rect x="2" y="4" width="20" height="16" rx="3"/>`,
    accent: "#f5a623",
  },
];

const process = [
  { step: "01", title: "Consultation", text: "We visit your site, understand your needs and budget." },
  { step: "02", title: "Planning & Quote", text: "Clear scope, drawings, timeline and a transparent quote." },
  { step: "03", title: "Execution", text: "Skilled crews build under engineer supervision." },
  { step: "04", title: "Handover", text: "Quality checks, documentation and on-time delivery." },
];

const categories = ["All", ...new Set(services.map(s => s.category))];
---

<Layout title="Services - Gallop Construction" description="Civil, mechanical, insulation and ducting services by Gallop Construction">
  <Navbar />

  <!-- ══ HERO ══ -->
  <section class="svc-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-grid"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>

    <div class="hero-inner">
      <span class="hero-badge">
        <span class="bdot"></span> Our Services <span class="bdot"></span>
      </span>
      <h1 class="hero-title">
        Complete Construction<br/>
        <span class="title-em">Solutions Under One Roof</span>
      </h1>
      <p class="hero-sub">
        Civil works, mechanical fabrication, insulation and ducting — Gallop Construction
        brings every trade together with one team, one timeline and one point of
        responsibility for your project.
      </p>
      <div class="stat-pills">
        {[
          { v: "10+",  l: "Years Experience" },
          { v: String(services.length), l: "Service Verticals" },
          { v: "50+",  l: "Projects Delivered" },
          { v: "100%", l: "Safety Focused" },
        ].map(s => (
          <div class="pill">
            <span class="pill-v">{s.v}</span>
            <span class="pill-l">{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ FILTER ══ -->
  <div class="filter-strip">
    <div class="wrap filter-inner">
      {categories.map((cat, i) => (
        <button class={`ftab ${i === 0 ? 'active' : ''}`} data-cat={cat}>
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- ══ SERVICES LIST ══ -->
  <main class="svc-main">
    <div class="wrap">
      <div class="svc-list" id="svcList">
        {services.map((s) => (
          <article class="svc-row" style={`--accent:${s.accent}`} data-category={s.category}>
            <div class="row-num">{s.id}</div>

            <!-- Gallery -->
            <div class="row-img-wrap">
              <div class="gallery" data-gallery>
                <div class="gal-main">
                  <img src={s.images[0]} alt={s.title} class="gal-main-img" loading="lazy" />
                  <div class="gal-overlay"></div>
                  <span class="row-cat-badge">{s.category}</span>

                  <button class="gal-arrow gal-prev" data-dir="prev" aria-label="Previous image">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
                  </button>
                  <button class="gal-arrow gal-next" data-dir="next" aria-label="Next image">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
                  </button>

                  <div class="gal-count">1 / {s.images.length}</div>
                </div>

                <div class="gal-thumbs">
                  {s.images.map((img, i) => (
                    <button class={`gal-thumb${i === 0 ? ' active' : ''}`} aria-label={`View image ${i + 1}`}>
                      <img src={img} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="row-content">
              <div class="svc-head">
                <div class="svc-icon-wrap">
                  <svg width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={s.icon}></svg>
                </div>
                <p class="svc-id-label">Service {s.id}</p>
              </div>

              <h2 class="svc-title">{s.title}</h2>
              <p class="svc-subtitle">{s.subtitle}</p>
              <p class="svc-desc">{s.description}</p>

              <ul class="feat-list">
                {s.features.map(f => (
                  <li class="feat-item">
                    <span class="feat-check">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>

              <a href="/contact" class="svc-cta">
                Request This Service
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div id="emptyState" style="display:none" class="empty-state">
        No services found for this category.
      </div>
    </div>
  </main>

  <!-- ══ PROCESS ══ -->
  <section class="process">
    <div class="wrap">
      <div class="process-head">
        <span class="eyebrow"><span class="eyebrow-line"></span>How We Work<span class="eyebrow-line"></span></span>
        <h2 class="section-title">A Simple, <span class="accent">Transparent</span> Process</h2>
      </div>
      <div class="process-grid">
        {process.map((p) => (
          <div class="step">
            <span class="step-num">{p.step}</span>
            <h3 class="step-title">{p.title}</h3>
            <p class="step-text">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ BOTTOM CTA ══ -->
  <section class="bottom-cta">
    <div class="wrap">
      <div class="cta-card">
        <div class="cta-glow" aria-hidden="true"></div>
        <h2 class="cta-title">
          Ready to Build with <span class="cta-em">Gallop Construction?</span>
        </h2>
        <p class="cta-sub">
          Tell us about your project and get a free consultation and detailed quote — no obligation.
        </p>
        <div class="cta-btns">
          <a href="/contact" class="btn-solid">
            Get a Free Quote
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="/projects" class="btn-outline">View Our Projects</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollUpButton />
</Layout>

<style>
  :root {
    --g-blue: #f5a623;
    --g-blue-soft: rgba(245,166,35,0.12);
    --g-navy: #ffffff;
    --g-text: #aab4c3;
    --g-line: #263040;
  }

  .wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

  /* ── HERO (navy, taa ke navbar white text saaf dikhe) ── */
  .svc-hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: linear-gradient(160deg, #0d1218 0%, #151c26 55%, #1c2532 100%);
    padding: 10rem 1.5rem 6rem;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .hero-grid {
    position: absolute; inset: -60px;
    background-image:
      linear-gradient(rgba(251,191,36,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251,191,36,0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    animation: gridMove 20s linear infinite;
  }
  @keyframes gridMove { to { transform: translate(60px, 60px); } }
  .hero-orb { position: absolute; border-radius: 50%; filter: blur(100px); animation: orb 16s ease-in-out infinite alternate; }
  .hero-orb-1 { width: 480px; height: 480px; background: rgba(245,166,35,0.45); top: -180px; left: -120px; }
  .hero-orb-2 { width: 400px; height: 400px; background: rgba(245,158,11,0.30); bottom: -180px; right: -100px; animation-delay: -8s; }
  @keyframes orb { to { transform: translate(70px, 50px) scale(1.1); } }

  .hero-inner {
    position: relative; z-index: 1; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1.3rem;
    max-width: 800px;
    animation: fadeUp 0.8s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: #fff;
    border: 1px solid rgba(251,191,36,0.45); border-radius: 999px;
    padding: 7px 18px; background: rgba(245,166,35,0.16);
  }
  .bdot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #fbbf24; box-shadow: 0 0 8px #fbbf24; animation: bp 1.8s ease infinite; }
  @keyframes bp { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }

  .hero-title {
    font-size: clamp(2.3rem, 5.5vw, 4.4rem); font-weight: 800;
    line-height: 1.1; letter-spacing: -0.02em; color: #fff !important; margin: 0;
  }
  .title-em { color: #fbbf24 !important; }
  .hero-sub { max-width: 600px; color: rgba(255,255,255,0.75); font-size: clamp(0.92rem, 1.4vw, 1.05rem); line-height: 1.8; margin: 0; }

  .stat-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 0.6rem; }
  .pill {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(251,191,36,0.30);
    border-radius: 16px; padding: 1rem 1.8rem;
    backdrop-filter: blur(8px);
  }
  .pill-v { font-size: 1.6rem; font-weight: 800; color: #fbbf24; line-height: 1; }
  .pill-l { font-size: 0.64rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: rgba(255,255,255,0.70); }

  /* ── Filter ── */
  .filter-strip {
    position: sticky; top: 0; z-index: 40;
    background: rgba(22,29,39,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--g-line);
    padding: 1rem 0;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  .filter-inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .ftab {
    font-size: 0.8rem; font-weight: 600;
    padding: 8px 22px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--g-line);
    background: #161d27; color: var(--g-text);
    font-family: inherit;
    transition: all 0.25s;
  }
  .ftab:hover { color: var(--g-blue); border-color: rgba(245,166,35,0.35); background: var(--g-blue-soft); }
  .ftab.active { background: var(--g-blue); border-color: var(--g-blue); color: #10151c; box-shadow: 0 6px 16px rgba(245,166,35,0.30); }

  /* ── Services list ── */
  .svc-main {
    background: linear-gradient(180deg, #10151c 0%, #161d27 100%);
    padding: 3rem 0 4rem;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  .svc-list { display: flex; flex-direction: column; }

  .svc-row {
    position: relative;
    display: grid; grid-template-columns: 1fr; gap: 2.5rem;
    padding: 4rem 0;
    border-bottom: 1px solid var(--g-line);
  }
  .svc-row:last-child { border-bottom: none; }
  @media (min-width: 900px) {
    .svc-row { grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .svc-row:nth-child(even) .row-img-wrap { order: 2; }
    .svc-row:nth-child(even) .row-content  { order: 1; }
  }

  .row-num {
    position: absolute; top: 2.5rem; right: 0;
    font-size: 7rem; font-weight: 800; line-height: 1;
    color: rgba(245,166,35,0.06);
    pointer-events: none; user-select: none; letter-spacing: -0.05em;
  }
  @media (max-width: 899px) { .row-num { font-size: 4rem; } }

  .row-img-wrap { position: relative; z-index: 1; }

  /* Gallery */
  .gallery { display: flex; flex-direction: column; gap: 0.7rem; }
  .gal-main {
    position: relative;
    border-radius: 22px; overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #263040;
    box-shadow: 0 24px 50px rgba(0,0,0,0.48);
  }
  .gal-main::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit;
    border: 3px solid transparent; transition: border-color 0.4s;
    pointer-events: none; z-index: 2;
  }
  .svc-row:hover .gal-main::after { border-color: var(--accent); }
  .gal-main-img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.28s ease, transform 0.7s ease; }
  .svc-row:hover .gal-main-img { transform: scale(1.04); }
  .gal-overlay {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgba(10,13,18,0.45) 0%, transparent 45%);
  }

  .row-cat-badge {
    position: absolute; top: 16px; left: 16px; z-index: 3;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 999px;
    background: rgba(22,29,39,0.94); color: var(--accent);
  }

  .gal-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 42px; height: 42px; border-radius: 50%;
    background: rgba(22,29,39,0.92); border: none;
    color: var(--g-navy);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 4;
    box-shadow: 0 6px 16px rgba(0,0,0,0.60);
    opacity: 0;
    transition: background 0.2s, color 0.2s, transform 0.2s, opacity 0.3s;
  }
  .gal-main:hover .gal-arrow { opacity: 1; }
  .gal-prev { left: 14px; }
  .gal-next { right: 14px; }
  .gal-arrow:hover { background: var(--accent); color: #fff; transform: translateY(-50%) scale(1.08); }
  @media (hover: none) { .gal-arrow { opacity: 1; } }

  .gal-count {
    position: absolute; bottom: 14px; right: 14px; z-index: 4;
    font-size: 0.7rem; font-weight: 700;
    color: #fff; background: rgba(10,13,18,0.65);
    backdrop-filter: blur(8px);
    padding: 5px 12px; border-radius: 999px;
  }

  .gal-thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem; }
  .gal-thumb {
    padding: 0; margin: 0;
    border-radius: 10px; overflow: hidden; cursor: pointer;
    aspect-ratio: 1;
    border: 2px solid transparent;
    background: #263040;
    opacity: 0.55;
    transition: opacity 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .gal-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gal-thumb:hover { opacity: 0.85; transform: translateY(-2px); }
  .gal-thumb.active { border-color: var(--accent); opacity: 1; box-shadow: 0 6px 16px rgba(245,166,35,0.25); }

  /* Content */
  .row-content { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1rem; }
  .svc-head { display: flex; align-items: center; gap: 14px; }
  .svc-icon-wrap {
    width: 56px; height: 56px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent); color: #fff;
    box-shadow: 0 10px 22px rgba(245,166,35,0.28);
  }
  .svc-id-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .svc-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 800;
    color: var(--g-navy) !important; line-height: 1.15; letter-spacing: -0.02em; margin: 0;
  }
  .svc-subtitle { font-size: 0.95rem; font-weight: 600; color: var(--accent); margin: -0.3rem 0 0; }
  .svc-desc { font-size: 0.97rem; color: var(--g-text); line-height: 1.8; margin: 0; }

  .feat-list {
    list-style: none; padding: 0; margin: 0.4rem 0 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem 1.2rem;
  }
  .feat-item { display: flex; align-items: center; gap: 0.65rem; font-size: 0.9rem; font-weight: 600; color: var(--g-navy); }
  .feat-check {
    flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--g-blue-soft); color: var(--accent);
  }

  .svc-cta {
    margin-top: 0.8rem;
    display: inline-flex; align-items: center; gap: 10px; width: fit-content;
    padding: 13px 28px; border-radius: 999px;
    background: var(--accent); color: #fff !important;
    font-size: 0.9rem; font-weight: 600; text-decoration: none;
    box-shadow: 0 10px 22px rgba(245,166,35,0.28);
    transition: transform 0.25s, box-shadow 0.25s, filter 0.25s;
  }
  .svc-cta:hover { transform: translateY(-2px); filter: brightness(0.92); box-shadow: 0 14px 30px rgba(245,166,35,0.38); }
  .svc-cta svg { transition: transform 0.25s; }
  .svc-cta:hover svg { transform: translateX(4px); }

  .empty-state { text-align: center; padding: 5rem 2rem; color: var(--g-text); font-size: 0.95rem; }

  /* ── Process ── */
  .process { background: #161d27; padding: 5rem 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
  .process-head { text-align: center; margin-bottom: 3rem; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--g-blue); margin-bottom: 0.8rem;
  }
  .eyebrow-line { width: 30px; height: 3px; border-radius: 2px; background: var(--g-blue); }
  .section-title { margin: 0; font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--g-navy) !important; }
  .section-title .accent { color: var(--g-blue) !important; }

  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; position: relative; }
  .process-grid::before {
