---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ScrollUpButton from '../../components/ScrollUpButton.astro';

// SAMPLE projects — apne asal projects ke naam, jagah, saal aur tasveerein yahan daalein.
// Tasveer ke liye: image: "/projects/my-project.jpg"  (file public/projects/ mein rakhein)
const projects = [
  {
    id: 1,
    title: "Industrial Processing Plant",
    location: "Sheikhupura",
    year: "2024",
    category: "Mechanical",
    scope: "Plant Installation & Pipe Insulation",
    description: "Complete mechanical package — steam line installation, process piping, insulation and final commissioning for a food processing facility.",
    tags: ["Installation", "Insulation", "Commissioning"],
    image: "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=900&q=80",
  },
  {
    id: 2,
    title: "Corporate Office Complex",
    location: "Lahore",
    year: "2024",
    category: "Civil",
    scope: "RCC Structure & Finishing",
    description: "Multi-storey RCC structure with masonry, plaster and external works, delivered on schedule with stage-wise quality inspections.",
    tags: ["RCC", "Masonry", "Finishing"],
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=900&q=80",
  },
  {
    id: 3,
    title: "Textile Manufacturing Unit",
    location: "Faisalabad",
    year: "2023",
    category: "Mechanical",
    scope: "Structural Erection & Welding",
    description: "Structural steel erection, platform fabrication and welding works for a new production hall.",
    tags: ["Structural", "Welding", "Erection"],
    image: "https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=900&q=80",
  },
  {
    id: 4,
    title: "Cold Storage Facility",
    location: "Lahore",
    year: "2023",
    category: "Insulation",
    scope: "Cold-Line Insulation & Cladding",
    description: "Chilled-water and cold-line insulation with aluminium cladding to cut energy loss and protect pipelines.",
    tags: ["Cold Line", "Cladding", "Energy Saving"],
    image: "https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=900&q=80",
  },
  {
    id: 5,
    title: "Warehouse & Distribution Hub",
    location: "Kasur",
    year: "2023",
    category: "Civil",
    scope: "Foundation, Flooring & Steel Shed",
    description: "Heavy-duty foundations, industrial flooring and a pre-engineered steel shed for a large distribution warehouse.",
    tags: ["Foundation", "Flooring", "Steel Shed"],
    image: "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=900&q=80",
  },
  {
    id: 6,
    title: "Boiler House Upgrade",
    location: "Sheikhupura",
    year: "2022",
    category: "Mechanical",
    scope: "Boiler Installation & Overhauling",
    description: "Installation of a new industrial boiler, overhaul of the existing unit and complete steam distribution piping.",
    tags: ["Boiler", "Piping", "Overhauling"],
    image: "https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=900&q=80",
  },
  {
    id: 7,
    title: "Commercial Plaza HVAC",
    location: "Lahore",
    year: "2022",
    category: "Insulation",
    scope: "HVAC Ducting & Insulation",
    description: "Fabrication and installation of GI ductwork with thermal insulation across all floors of a commercial plaza.",
    tags: ["HVAC", "Ducting", "Insulation"],
    image: "https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=900&q=80",
  },
  {
    id: 8,
    title: "Residential Villa",
    location: "Lahore",
    year: "2022",
    category: "Civil",
    scope: "Grey Structure to Finishing",
    description: "Complete construction of a modern family home — from excavation and grey structure to tiling, plaster and paint.",
    tags: ["Residential", "Grey Structure", "Finishing"],
    image: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=900&q=80",
  },
  {
    id: 9,
    title: "Storage Tank Farm",
    location: "Gujranwala",
    year: "2021",
    category: "Mechanical",
    scope: "MS Tank Fabrication & Testing",
    description: "Fabrication, erection and pressure testing of multiple mild-steel storage tanks with anti-corrosion coating.",
    tags: ["MS Tanks", "Fabrication", "Testing"],
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=900&q=80",
  },
];

const categories = ["All", ...new Set(projects.map(p => p.category))];
const countFor = (cat: string) => cat === "All" ? projects.length : projects.filter(p => p.category === cat).length;

const stats = [
  { value: "50+",  label: "Projects Completed" },
  { value: "10+",  label: "Years Experience" },
  { value: "3",    label: "Service Lines" },
  { value: "100%", label: "On-Time Delivery" },
];
---

<Layout title="Projects - Gallop Construction" description="Civil, mechanical and insulation projects delivered by Gallop Construction">
  <Navbar />

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <div class="pp">

    <!-- ══ HERO ══ -->
    <section class="pp-hero">
      <div class="pp-hero-bg" aria-hidden="true">
        <div class="pp-grid-bg"></div>
        <div class="pp-orb pp-orb-1"></div>
        <div class="pp-orb pp-orb-2"></div>
      </div>
      <div class="pp-hero-inner">
        <span class="pp-badge"><span class="pp-bdot"></span> Our Work <span class="pp-bdot"></span></span>
        <h1 class="pp-hero-title">Projects That <span class="pp-hero-em">Speak for Us</span></h1>
        <p class="pp-hero-sub">
          From factories and warehouses to offices and homes — explore the civil, mechanical and
          insulation projects Gallop Construction has delivered.
        </p>
        <nav class="pp-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          <span>Projects</span>
        </nav>
      </div>
    </section>

    <!-- ══ STATS (overlap) ══ -->
    <div class="pp-wrap">
      <div class="pp-stats">
        {stats.map(s => (
          <div class="pp-stat">
            <span class="pp-stat-val">{s.value}</span>
            <span class="pp-stat-lbl">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- ══ PROJECTS ══ -->
    <section class="pp-sec">
      <div class="pp-wrap">

        <div class="pp-toolbar">
          <div>
            <span class="pp-eyebrow"><span class="pp-eyebrow-line"></span>Portfolio</span>
            <h2 class="pp-title">Featured <span class="pp-accent">Projects</span></h2>
          </div>
          <div class="pp-filters" role="tablist">
            {categories.map((cat, i) => (
              <button class={`pp-filter${i === 0 ? ' active' : ''}`} data-cat={cat} role="tab">
                {cat}
                <span class="pp-filter-count">{countFor(cat)}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="pp-grid" id="ppGrid">
          {projects.map((p, i) => (
            <article class={`pp-card${i === 0 ? ' pp-card-feature' : ''}`} data-category={p.category} style={`--d:${(i % 3) * 90}ms`}>
              <div class="pp-media">
                <img src={p.image} alt={p.title} class="pp-img" loading={i < 3 ? 'eager' : 'lazy'} />
                <div class="pp-shade"></div>
                <span class="pp-cat">{p.category}</span>
                <span class="pp-year">{p.year}</span>

                <div class="pp-hover">
                  <p class="pp-hover-desc">{p.description}</p>
                  <a href="/contact" class="pp-hover-btn">
                    Start a Similar Project
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                </div>
              </div>

              <div class="pp-body">
                <div class="pp-meta">
                  <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
                    {p.location}
                  </span>
                  <span class="pp-num">#{String(p.id).padStart(2, '0')}</span>
                </div>
                <h3 class="pp-card-title">{p.title}</h3>
                <p class="pp-scope">{p.scope}</p>
                <p class="pp-desc">{p.description}</p>
                <div class="pp-tags">
                  {p.tags.map(t => <span class="pp-tag">{t}</span>)}
                </div>
                <div class="pp-foot">
                  <span class="pp-done">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    Completed
                  </span>
                  <span class="pp-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="pp-empty" id="ppEmpty" style="display:none">No projects found in this category.</div>
      </div>
    </section>

    <!-- ══ CTA ══ -->
    <section class="pp-cta-sec">
      <div class="pp-wrap">
        <div class="pp-cta">
          <div class="pp-cta-glow" aria-hidden="true"></div>
          <div class="pp-cta-text">
            <h2 class="pp-cta-title">Have a project in mind?</h2>
            <p class="pp-cta-sub">Tell us what you're planning — we'll visit your site and send a free, detailed quote.</p>
          </div>
          <div class="pp-cta-btns">
            <a href="/contact" class="pp-btn-solid">
              Get a Free Quote
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/services" class="pp-btn-outline">Our Services</a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Footer />
  <ScrollUpButton />
</Layout>

<style>
  .pp {
    --blue: #f5a623;
    --blue-light: #fbbf24;
    --blue-soft: rgba(245,166,35,0.12);
    --navy: #ffffff;
    --text: #aab4c3;
    --line: #263040;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: var(--navy);
    background: linear-gradient(180deg, #10151c 0%, #161d27 40%);
  }
  .pp-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

  /* ── Hero ── */
  .pp-hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: linear-gradient(160deg, #0d1218 0%, #151c26 55%, #1c2532 100%);
    padding: 10rem 1.5rem 9rem; text-align: center;
  }
  .pp-hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .pp-grid-bg {
    position: absolute; inset: -60px;
    background-image: linear-gradient(rgba(251,191,36,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(251,191,36,0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    animation: ppGrid 20s linear infinite;
  }
  @keyframes ppGrid { to { transform: translate(60px, 60px); } }
  .pp-orb { position: absolute; border-radius: 50%; filter: blur(100px); animation: ppOrb 16s ease-in-out infinite alternate; }
  .pp-orb-1 { width: 480px; height: 480px; background: rgba(245,166,35,0.45); top: -180px; left: -120px; }
  .pp-orb-2 { width: 400px; height: 400px; background: rgba(245,158,11,0.30); bottom: -180px; right: -100px; animation-delay: -8s; }
  @keyframes ppOrb { to { transform: translate(70px, 50px) scale(1.1); } }

  .pp-hero-inner { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.3rem; animation: ppUp 0.9s cubic-bezier(.22,1,.36,1) both; }
  @keyframes ppUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  .pp-badge { display: inline-flex; align-items: center; gap: 10px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; border: 1px solid rgba(251,191,36,0.45); border-radius: 999px; padding: 7px 18px; background: rgba(245,166,35,0.16); }
  .pp-bdot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-light); box-shadow: 0 0 8px var(--blue-light); animation: ppPulse 1.8s ease infinite; }
  @keyframes ppPulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }
  .pp-hero-title { margin: 0; font-size: clamp(2.4rem, 5.5vw, 4.4rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: #fff !important; }
  .pp-hero-em { color: var(--blue-light) !important; }
  .pp-hero-sub { margin: 0; max-width: 620px; font-size: clamp(0.95rem, 1.4vw, 1.08rem); line-height: 1.8; color: rgba(255,255,255,0.78); }
  .pp-crumbs { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 999px; background: rgba(255,255,255,0.08); font-size: 0.85rem; color: rgba(255,255,255,0.75); }
  .pp-crumbs a { color: #fff; text-decoration: none; font-weight: 600; }
  .pp-crumbs a:hover { color: var(--blue-light); }
  .pp-crumbs svg { width: 14px; height: 14px; }

  /* ── Stats ── */
  .pp-stats { position: relative; z-index: 2; margin-top: -60px; display: grid; grid-template-columns: repeat(4, 1fr); background: #161d27; border-radius: 22px; box-shadow: 0 24px 50px rgba(0,0,0,0.42); padding: 1.8rem 0.5rem; }
  .pp-stat { display: flex; flex-direction: column; align-items: center; gap: 6px; border-right: 1px solid var(--line); }
  .pp-stat:last-child { border-right: none; }
  .pp-stat-val { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 800; line-height: 1; color: var(--blue); }
  .pp-stat-lbl { font-size: 0.8rem; font-weight: 600; color: var(--text); text-align: center; }

  /* ── Section ── */
  .pp-sec { padding: 5rem 0 4rem; }
  .pp-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.4rem; }
  .pp-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); margin-bottom: 0.8rem; }
  .pp-eyebrow-line { width: 34px; height: 3px; border-radius: 2px; background: var(--blue); }
  .pp-title { margin: 0; font-size: clamp(1.9rem, 3.6vw, 2.8rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--navy) !important; }
  .pp-accent { color: var(--blue) !important; }

  .pp-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 6px; background: #161d27; border: 1px solid var(--line); border-radius: 999px; box-shadow: 0 8px 22px rgba(0,0,0,0.18); }
  .pp-filter {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 18px; border: none; border-radius: 999px;
    background: transparent; color: var(--text);
    font-family: inherit; font-size: 0.85rem; font-weight: 600;
    cursor: pointer; transition: background 0.25s, color 0.25s, box-shadow 0.25s;
  }
  .pp-filter:hover { color: var(--blue); background: var(--blue-soft); }
  .pp-filter.active { background: var(--blue); color: #10151c; box-shadow: 0 6px 16px rgba(245,166,35,0.30); }
  .pp-filter-count { display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); font-size: 0.72rem; font-weight: 700; }
  .pp-filter.active .pp-filter-count { background: rgba(255,255,255,0.22); color: #fff; }

  /* ── Grid ── */
  .pp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .pp-card {
    display: flex; flex-direction: column;
    background: #161d27; border: 1px solid var(--line); border-radius: 22px; overflow: hidden;
    box-shadow: 0 10px 28px rgba(0,0,0,0.18);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1), box-shadow 0.4s, border-color 0.4s, opacity 0.4s;
  }
  .pp-card:hover { transform: translateY(-8px); border-color: rgba(245,166,35,0.30); box-shadow: 0 26px 50px rgba(0,0,0,0.42); }

  /* Featured: pehla card 2 columns ka, image side par */
  .pp-card-feature { grid-column: span 2; flex-direction: row; }
  .pp-card-feature .pp-media { flex: 1.15; height: auto; min-height: 380px; }
  .pp-card-feature .pp-body { flex: 1; padding: 2rem; }
  .pp-card-feature .pp-card-title { font-size: 1.6rem; }
  .pp-card-feature .pp-hover { display: none; }
  .pp-card-feature .pp-desc { display: block; }

  .pp-media { position: relative; height: 240px; overflow: hidden; background: #263040; }
  .pp-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(.22,1,.36,1); }
  .pp-card:hover .pp-img { transform: scale(1.08); }
  .pp-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,13,18,0.45), transparent 55%); }
  .pp-cat, .pp-year {
    position: absolute; top: 14px; z-index: 2;
    padding: 6px 13px; border-radius: 999px;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .pp-cat { left: 14px; background: rgba(22,29,39,0.94); color: var(--blue); }
  .pp-year { right: 14px; background: rgba(10,13,18,0.65); color: #fff; backdrop-filter: blur(6px); }

  /* Hover overlay (normal cards) */
  .pp-hover {
    position: absolute; inset: 0; z-index: 3;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 1rem;
    padding: 1.4rem;
    background: linear-gradient(to top, rgba(10,13,18,0.95) 10%, rgba(10,13,18,0.55) 70%, rgba(255,255,255,0.2));
    opacity: 0; transition: opacity 0.4s;
  }
  .pp-card:hover .pp-hover { opacity: 1; }
  .pp-hover-desc { margin: 0; font-size: 0.88rem; line-height: 1.6; color: rgba(255,255,255,0.9); transform: translateY(12px); transition: transform 0.45s cubic-bezier(.22,1,.36,1); }
  .pp-hover-btn {
    align-self: flex-start;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 999px;
    background: #161d27; color: var(--blue) !important;
    font-size: 0.82rem; font-weight: 700; text-decoration: none;
    transform: translateY(12px); transition: transform 0.45s cubic-bezier(.22,1,.36,1) 0.05s, background 0.25s;
  }
  .pp-hover-btn svg { width: 15px; height: 15px; }
  .pp-hover-btn:hover { background: var(--blue-soft); }
  .pp-card:hover .pp-hover-desc, .pp-card:hover .pp-hover-btn { transform: none; }

  .pp-body { display: flex; flex: 1; flex-direction: column; padding: 1.3rem 1.4rem 1.3rem; }
  .pp-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
  .pp-meta span:first-child { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--text); }
  .pp-meta svg { width: 15px; height: 15px; color: var(--blue); }
  .pp-num { font-size: 0.78rem; font-weight: 700; color: #6b7686; }
  .pp-card-title { margin: 0; font-size: 1.2rem; font-weight: 800; line-height: 1.3; color: var(--navy); transition: color 0.3s; }
  .pp-card:hover .pp-card-title { color: var(--blue); }
  .pp-scope { margin: 0.35rem 0 0.8rem; font-size: 0.85rem; font-weight: 600; color: var(--blue); }
  .pp-desc { display: none; margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.75; color: var(--text); }
  .pp-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.1rem; }
  .pp-tag { padding: 4px 11px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); font-size: 0.72rem; font-weight: 600; }
  .pp-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: 1rem; border-top: 1px dashed var(--line); }
  .pp-done { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 700; color: var(--blue); }
  .pp-done svg { width: 14px; height: 14px; }
  .pp-arrow { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--blue-soft); color: var(--blue); transition: background 0.3s, color 0.3s, transform 0.3s; }
  .pp-arrow svg { width: 16px; height: 16px; }
  .pp-card:hover .pp-arrow { background: var(--blue); color: #10151c; transform: rotate(45deg); }

  .pp-empty { text-align: center; padding: 4rem 1rem; color: var(--text); }

  /* Filter animation */
  .pp-card.is-hiding { opacity: 0; transform: scale(0.96); }

  /* Scroll reveal (sirf JS ke saath) */
  :global(.pp-js) .pp-card { opacity: 0; transform: translateY(36px); }
  :global(.pp-js) .pp-card.is-in {
    opacity: 1; transform: none;
    transition: opacity 0.7s ease var(--d), transform 0.8s cubic-bezier(.22,1,.36,1) var(--d), box-shadow 0.4s, border-color 0.4s;
  }
  :global(.pp-js) .pp-card.is-in:hover { transform: translateY(-8px); transition-delay: 0ms; }
  :global(.pp-js) .pp-card.is-in.is-hiding { opacity: 0; transform: scale(0.96); transition-delay: 0ms; }

  /* ── CTA ── */
  .pp-cta-sec { padding: 1rem 0 6rem; }
  .pp-cta {
    position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
    padding: 3.2rem 3rem; border-radius: 28px;
    background: linear-gradient(120deg, #151c26 0%, #1c2532 55%, #f5a623 100%);
    box-shadow: 0 30px 60px rgba(0,0,0,0.75);
  }
  .pp-cta-glow { position: absolute; width: 420px; height: 420px; border-radius: 50%; background: rgba(251,191,36,0.35); filter: blur(90px); top: -200px; right: -100px; animation: ppOrb 14s ease-in-out infinite alternate; }
  .pp-cta-text { position: relative; max-width: 560px; }
  .pp-cta-title { margin: 0 0 0.5rem; font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 800; color: #fff !important; }
  .pp-cta-sub { margin: 0; font-size: 1rem; line-height: 1.7; color: rgba(255,255,255,0.78); }
  .pp-cta-btns { position: relative; display: flex; flex-wrap: wrap; gap: 1rem; }
  .pp-btn-solid, .pp-btn-outline { display: inline-flex; align-items: center; gap: 10px; padding: 14px 30px; border-radius: 999px; font-size: 0.92rem; font-weight: 700; text-decoration: none; transition: background 0.25s, transform 0.25s, border-color 0.25s; }
  .pp-btn-solid { background: #161d27; color: var(--blue) !important; }
  .pp-btn-solid svg { width: 16px; height: 16px; }
  .pp-btn-solid:hover { transform: translateY(-2px); background: var(--blue-soft); }
  .pp-btn-outline { border: 1.5px solid rgba(255,255,255,0.45); color: #fff !important; background: rgba(255,255,255,0.06); }
  .pp-btn-outline:hover { transform: translateY(-2px); border-color: #1c2532; background: rgba(255,255,255,0.14); }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .pp-grid { grid-template-columns: repeat(2, 1fr); }
    .pp-card-feature { grid-column: span 2; }
