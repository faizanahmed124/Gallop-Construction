</style>

<script is:inline>
  (function () {
    function init() {
      var page = document.querySelector('.pp');
      if (!page) return;
      var cards = page.querySelectorAll('.pp-card');
      var btns = page.querySelectorAll('.pp-filter');
      var empty = document.getElementById('ppEmpty');

      // ── Scroll reveal ──
      if ('IntersectionObserver' in window) {
        page.classList.add('pp-js');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        cards.forEach(function (c) { io.observe(c); });
      }

      // ── Filter ──
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          btns.forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          var cat = btn.getAttribute('data-cat');
          var visible = 0;

          cards.forEach(function (card) {
            var match = cat === 'All' || card.getAttribute('data-category') === cat;
            if (match) visible++;
            card.classList.add('is-hiding');
            setTimeout(function () {
              card.style.display = match ? '' : 'none';
              // filter lagne par featured layout sirf "All" mein
              card.classList.toggle('pp-card-feature', cat === 'All' && card === cards[0]);
              card.classList.add('is-in');
              requestAnimationFrame(function () { card.classList.remove('is-hiding'); });
            }, 250);
          });

          setTimeout(function () {
            if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
          }, 260);
        });
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>