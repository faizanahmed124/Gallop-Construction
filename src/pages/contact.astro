---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';

// ── Apni asal details yahan likhein ──
const company = {
  phone: "+92 300 1234567",
  whatsapp: "923001234567",              // sirf numbers, country code ke saath
  email: "info@gallopconstruction.com",
  address: "Lahore, Punjab, Pakistan",
  addressSub: "Office visits by appointment",
  hours: "Mon – Sat: 9:00 AM – 6:00 PM",
  hoursSub: "Closed on Sundays & public holidays",
  mapQuery: "Lahore, Pakistan",          // Google Maps mein jo likhenge wahi location
};

const quick = [
  {
    label: "Call Us",
    value: company.phone,
    sub: "Speak to our team directly",
    href: `tel:${company.phone.replace(/\s/g, '')}`,
    icon: `<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>`,
  },
  {
    label: "WhatsApp",
    value: "Chat with us",
    sub: "Quick replies during working hours",
    href: `https://wa.me/${company.whatsapp}`,
    icon: `<path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3L3 21Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.2-1.2a.8.8 0 0 0-.1-1.2l-1.3-.8a.8.8 0 0 0-1 .1l-.4.4a4 4 0 0 1-2.2-2.2l.4-.4a.8.8 0 0 0 .1-1l-.8-1.3a.8.8 0 0 0-1.2-.1L9 9.5Z"/>`,
    external: true,
  },
  {
    label: "Email Us",
    value: company.email,
    sub: "We reply within 24 hours",
    href: `mailto:${company.email}`,
    icon: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>`,
  },
];

const services = [
  "Civil Construction",
  "Residential Construction",
  "Commercial Construction",
  "Mechanical Works",
  "Insulation & Ducting",
  "Renovation & Remodeling",
  "Project Management",
  "Other",
];

const steps = [
  { title: "We review your request", text: "Our team reads your details and calls you back." },
  { title: "Site visit & discussion", text: "We visit your site to understand the scope." },
  { title: "Free detailed quote", text: "You get a clear quote with timeline and costs." },
];
---

<Layout title="Contact - Gallop Construction" description="Contact Gallop Construction for a free consultation and quote">
  <Navbar />

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <div class="ct">

    <!-- ══ HERO ══ -->
    <section class="ct-hero">
      <div class="ct-hero-bg" aria-hidden="true">
        <div class="ct-grid-bg"></div>
        <div class="ct-orb ct-orb-1"></div>
        <div class="ct-orb ct-orb-2"></div>
      </div>
      <div class="ct-hero-inner">
        <span class="ct-badge"><span class="ct-bdot"></span> Get In Touch <span class="ct-bdot"></span></span>
        <h1 class="ct-hero-title">Let's Talk About <span class="ct-hero-em">Your Project</span></h1>
        <p class="ct-hero-sub">
          Planning a new build, a factory upgrade or a renovation? Tell us what you need and our
          team will get back to you with a free consultation and quote.
        </p>
        <nav class="ct-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          <span>Contact</span>
        </nav>
      </div>
    </section>

    <!-- ══ QUICK CONTACT CARDS (overlap) ══ -->
    <div class="ct-wrap">
      <div class="ct-quick">
        {quick.map(q => (
          <a href={q.href} class="ct-quick-card" target={q.external ? '_blank' : undefined} rel={q.external ? 'noopener' : undefined}>
            <span class="ct-quick-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={q.icon}></svg>
            </span>
            <span class="ct-quick-text">
              <span class="ct-quick-label">{q.label}</span>
              <span class="ct-quick-value">{q.value}</span>
              <span class="ct-quick-sub">{q.sub}</span>
            </span>
            <span class="ct-quick-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- ══ FORM + INFO ══ -->
    <section class="ct-sec">
      <div class="ct-wrap ct-grid">

        <!-- FORM -->
        <div class="ct-form-card">
          <div class="ct-form-head">
            <span class="ct-eyebrow"><span class="ct-eyebrow-line"></span>Request a Quote</span>
            <h2 class="ct-title">Send Us a <span class="ct-accent">Message</span></h2>
            <p class="ct-form-sub">Fill in the details below — the more you tell us, the more accurate your quote will be.</p>
          </div>

          <form class="ct-form" id="ctForm" novalidate>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-name">Full Name <span class="ct-req">*</span></label>
                <div class="ct-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
                  <input id="ct-name" type="text" name="name" placeholder="Your full name" required autocomplete="name" />
                </div>
                <span class="ct-error">Please enter your name.</span>
              </div>
              <div class="ct-field">
                <label for="ct-phone">Phone / WhatsApp <span class="ct-req">*</span></label>
                <div class="ct-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
                  <input id="ct-phone" type="tel" name="phone" placeholder="+92 300 0000000" required autocomplete="tel" pattern="[\d\s+\-()]{7,}" />
                </div>
                <span class="ct-error">Please enter a valid phone number.</span>
              </div>
            </div>

            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-email">Email Address</label>
                <div class="ct-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                  <input id="ct-email" type="email" name="email" placeholder="example@email.com" autocomplete="email" />
                </div>
                <span class="ct-error">Please enter a valid email.</span>
              </div>
              <div class="ct-field">
                <label for="ct-location">Project Location</label>
                <div class="ct-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
                  <input id="ct-location" type="text" name="location" placeholder="e.g. Lahore, Sheikhupura" />
                </div>
              </div>
            </div>

            <div class="ct-field">
              <span class="ct-label">Service Required <span class="ct-req">*</span></span>
              <div class="ct-chips" role="radiogroup" aria-label="Service required">
                {services.map((s, i) => (
                  <label class="ct-chip">
                    <input type="radio" name="service" value={s} required={i === 0} />
                    <span>{s}</span>
                  </label>
                ))}
              </div>
              <span class="ct-error">Please choose a service.</span>
            </div>

            <div class="ct-field">
              <label for="ct-message">Project Details <span class="ct-req">*</span></label>
              <textarea id="ct-message" name="message" rows="5" placeholder="Tell us about your project — size, timeline, budget range and anything else we should know..." required maxlength="1000"></textarea>
              <div class="ct-msg-foot">
                <span class="ct-error">Please describe your project.</span>
                <span class="ct-count"><span id="ctCount">0</span>/1000</span>
              </div>
            </div>

            <div class="ct-actions">
              <button type="submit" class="ct-submit" id="ctSubmit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3L3 21Z"/></svg>
                <span id="ctBtnText">Send via WhatsApp</span>
              </button>
              <button type="button" class="ct-submit-alt" id="ctEmailBtn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                Send via Email
              </button>
            </div>

            <p class="ct-note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Your information is kept private and never shared.
            </p>
          </form>

          <div class="ct-success" id="ctSuccess" hidden>
            <div class="ct-success-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3>Almost done!</h3>
            <p>Your message has opened in <strong id="ctChannel">WhatsApp</strong>. Just press <strong>Send</strong> there and our team will get back to you shortly.</p>
            <button type="button" class="ct-submit-alt" id="ctReset">Send another message</button>
          </div>
        </div>

        <!-- INFO SIDEBAR -->
        <aside class="ct-side">
          <div class="ct-info-card">
            <h3 class="ct-side-title">Office Information</h3>
            <ul class="ct-info-list">
              <li>
                <span class="ct-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
                <span><strong>{company.address}</strong><small>{company.addressSub}</small></span>
              </li>
              <li>
                <span class="ct-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                <span><strong>{company.hours}</strong><small>{company.hoursSub}</small></span>
              </li>
            </ul>
          </div>

          <div class="ct-steps-card">
            <h3 class="ct-side-title ct-side-title-light">What Happens Next?</h3>
            <ol class="ct-steps">
              {steps.map((s, i) => (
                <li>
                  <span class="ct-step-num">{i + 1}</span>
                  <span><strong>{s.title}</strong><small>{s.text}</small></span>
                </li>
              ))}
            </ol>
          </div>

          <div class="ct-map">
            <iframe
              src={`https://www.google.com/maps?q=${encodeURIComponent(company.mapQuery)}&z=12&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Gallop Construction location"
              allowfullscreen
            ></iframe>
            <a href={`https://maps.google.com/?q=${encodeURIComponent(company.mapQuery)}`} target="_blank" rel="noopener" class="ct-map-btn">
              Open in Google Maps
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </a>
          </div>
        </aside>

      </div>
    </section>

  </div>

  <Footer />
  <ScrollUpButton />
</Layout>

<style>
  .ct {
    --blue: #f5a623;
    --blue-light: #fbbf24;
    --blue-soft: rgba(245,166,35,0.12);
    --navy: #ffffff;
    --text: #aab4c3;
    --line: #263040;
    --error: #e5484d;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: var(--navy);
    background: linear-gradient(180deg, #10151c 0%, #161d27 60%);
  }
  .ct-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

  /* ── Hero ── */
  .ct-hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: linear-gradient(160deg, #0d1218 0%, #151c26 55%, #1c2532 100%);
    padding: 10rem 1.5rem 9rem; text-align: center;
  }
  .ct-hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .ct-grid-bg {
    position: absolute; inset: -60px;
    background-image: linear-gradient(rgba(251,191,36,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(251,191,36,0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    animation: ctGrid 20s linear infinite;
  }
  @keyframes ctGrid { to { transform: translate(60px, 60px); } }
  .ct-orb { position: absolute; border-radius: 50%; filter: blur(100px); animation: ctOrb 16s ease-in-out infinite alternate; }
  .ct-orb-1 { width: 480px; height: 480px; background: rgba(245,166,35,0.45); top: -180px; left: -120px; }
  .ct-orb-2 { width: 400px; height: 400px; background: rgba(245,158,11,0.30); bottom: -180px; right: -100px; animation-delay: -8s; }
  @keyframes ctOrb { to { transform: translate(70px, 50px) scale(1.1); } }

  .ct-hero-inner { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.3rem; animation: ctUp 0.9s cubic-bezier(.22,1,.36,1) both; }
  @keyframes ctUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  .ct-badge { display: inline-flex; align-items: center; gap: 10px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; border: 1px solid rgba(251,191,36,0.45); border-radius: 999px; padding: 7px 18px; background: rgba(245,166,35,0.16); }
  .ct-bdot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-light); box-shadow: 0 0 8px var(--blue-light); animation: ctPulse 1.8s ease infinite; }
  @keyframes ctPulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }
  .ct-hero-title { margin: 0; font-size: clamp(2.4rem, 5.5vw, 4.4rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: #fff !important; }
  .ct-hero-em { color: var(--blue-light) !important; }
  .ct-hero-sub { margin: 0; max-width: 620px; font-size: clamp(0.95rem, 1.4vw, 1.08rem); line-height: 1.8; color: rgba(255,255,255,0.78); }
  .ct-crumbs { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 999px; background: rgba(255,255,255,0.08); font-size: 0.85rem; color: rgba(255,255,255,0.75); }
  .ct-crumbs a { color: #fff; text-decoration: none; font-weight: 600; }
  .ct-crumbs a:hover { color: var(--blue-light); }
  .ct-crumbs svg { width: 14px; height: 14px; }

  /* ── Quick cards ── */
  .ct-quick { position: relative; z-index: 2; margin-top: -70px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.3rem; }
  .ct-quick-card {
    position: relative;
    display: flex; align-items: center; gap: 1rem;
    padding: 1.4rem 1.4rem;
    background: #161d27; border: 1px solid var(--line); border-radius: 20px;
    box-shadow: 0 20px 44px rgba(0,0,0,0.36);
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(.22,1,.36,1), box-shadow 0.35s, border-color 0.35s;
  }
  .ct-quick-card:hover { transform: translateY(-6px); border-color: rgba(245,166,35,0.35); box-shadow: 0 28px 54px rgba(0,0,0,0.48); }
  .ct-quick-icon { flex-shrink: 0; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; background: linear-gradient(150deg, #ffb84d, #d98a0b); color: #10151c; box-shadow: 0 10px 22px rgba(245,166,35,0.30); transition: transform 0.4s cubic-bezier(.34,1.56,.64,1); }
  .ct-quick-icon svg { width: 26px; height: 26px; }
  .ct-quick-card:hover .ct-quick-icon { transform: rotate(-8deg) scale(1.06); }
  .ct-quick-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ct-quick-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); }
  .ct-quick-value { font-size: 1rem; font-weight: 800; color: var(--navy); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ct-quick-sub { font-size: 0.8rem; color: var(--text); }
  .ct-quick-arrow { margin-left: auto; flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--blue-soft); color: var(--blue); transition: background 0.3s, color 0.3s, transform 0.3s; }
  .ct-quick-arrow svg { width: 16px; height: 16px; }
  .ct-quick-card:hover .ct-quick-arrow { background: var(--blue); color: #10151c; transform: rotate(45deg); }

  /* ── Main grid ── */
  .ct-sec { padding: 4.5rem 0 6rem; }
  .ct-grid { display: grid; grid-template-columns: 1.55fr 1fr; gap: 2rem; align-items: start; }

  /* Form card */
  .ct-form-card {
    position: relative; overflow: hidden;
    padding: 2.6rem;
    background: #161d27; border: 1px solid var(--line); border-radius: 26px;
    box-shadow: 0 18px 44px rgba(0,0,0,0.24);
  }
  .ct-form-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #ffb84d, #f59e0b, transparent); }
  .ct-form-head { margin-bottom: 2rem; }
  .ct-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); margin-bottom: 0.7rem; }
  .ct-eyebrow-line { width: 30px; height: 3px; border-radius: 2px; background: var(--blue); }
  .ct-title { margin: 0 0 0.6rem; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--navy) !important; }
  .ct-accent { color: var(--blue) !important; }
  .ct-form-sub { margin: 0; font-size: 0.95rem; line-height: 1.7; color: var(--text); }

  .ct-form { display: flex; flex-direction: column; gap: 1.3rem; }
  .ct-form[hidden] { display: none; }
  .ct-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .ct-field { display: flex; flex-direction: column; gap: 0.45rem; }
  .ct-field label, .ct-label { font-size: 0.85rem; font-weight: 700; color: var(--navy); }
  .ct-req { color: var(--blue); }

  .ct-input { position: relative; }
  .ct-input svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #6b7686; pointer-events: none; transition: color 0.2s; }
  .ct-input input { padding-left: 44px !important; }
  .ct-input:focus-within svg { color: var(--blue); }

  .ct-field input, .ct-field textarea {
    width: 100%; box-sizing: border-box;
    padding: 13px 15px;
    font-family: inherit; font-size: 0.93rem; color: var(--navy);
    background: #131a23;
    border: 1.5px solid var(--line); border-radius: 13px;
    outline: none; resize: vertical;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .ct-field input::placeholder, .ct-field textarea::placeholder { color: #6b7686; }
  .ct-field input:focus, .ct-field textarea:focus { background: #161d27; border-color: var(--blue); box-shadow: 0 0 0 4px rgba(245,166,35,0.12); }

  /* Service chips */
  .ct-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .ct-chip { position: relative; cursor: pointer; }
  .ct-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .ct-chip span {
    display: inline-flex; align-items: center;
    padding: 9px 16px; border-radius: 999px;
    background: #131a23; border: 1.5px solid var(--line);
    font-size: 0.85rem; font-weight: 600; color: var(--text);
    transition: background 0.2s, border-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .ct-chip:hover span { border-color: rgba(245,166,35,0.45); color: var(--blue); }
  .ct-chip input:checked + span { background: var(--blue); border-color: var(--blue); color: #10151c; box-shadow: 0 6px 16px rgba(245,166,35,0.28); }
  .ct-chip input:focus-visible + span { box-shadow: 0 0 0 4px rgba(245,166,35,0.20); }

  .ct-msg-foot { display: flex; justify-content: space-between; gap: 1rem; }
  .ct-count { margin-left: auto; font-size: 0.75rem; color: #6b7686; }

  /* Errors */
  .ct-error { display: none; font-size: 0.78rem; font-weight: 600; color: var(--error); }
  .ct-field.has-error .ct-error { display: block; }
  .ct-field.has-error input, .ct-field.has-error textarea { border-color: var(--error); box-shadow: 0 0 0 4px rgba(229,72,77,0.10); }
  .ct-field.has-error .ct-chip span { border-color: rgba(229,72,77,0.5); }

  /* Buttons */
  .ct-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }
  .ct-submit, .ct-submit-alt {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 15px 28px; border-radius: 999px;
    font-family: inherit; font-size: 0.95rem; font-weight: 700;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s, border-color 0.25s, color 0.25s;
