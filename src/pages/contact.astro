  /* Success */
  .ct-success { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; padding: 3rem 1rem; animation: ctUp 0.6s cubic-bezier(.22,1,.36,1) both; }
  .ct-success[hidden] { display: none; }
  .ct-success-icon { width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: #10151c; box-shadow: 0 0 0 10px var(--blue-soft), 0 16px 30px rgba(245,166,35,0.30); }
  .ct-success-icon svg { width: 34px; height: 34px; }
  .ct-success h3 { margin: 0.6rem 0 0; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
  .ct-success p { margin: 0 0 0.6rem; max-width: 420px; font-size: 0.95rem; line-height: 1.7; color: var(--text); }

  /* ── Sidebar ── */
  .ct-side { display: flex; flex-direction: column; gap: 1.3rem; }
  .ct-info-card, .ct-steps-card, .ct-map { border-radius: 22px; overflow: hidden; }
  .ct-info-card { padding: 1.8rem; background: #161d27; border: 1px solid var(--line); box-shadow: 0 12px 30px rgba(0,0,0,0.18); }
  .ct-side-title { margin: 0 0 1.2rem; font-size: 1.1rem; font-weight: 800; color: var(--navy); }
  .ct-side-title-light { color: #fff; }
  .ct-info-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.1rem; }
  .ct-info-list li { display: flex; align-items: flex-start; gap: 12px; }
  .ct-info-icon { flex-shrink: 0; width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: var(--blue-soft); color: var(--blue); }
  .ct-info-icon svg { width: 20px; height: 20px; }
  .ct-info-list strong { display: block; font-size: 0.93rem; color: var(--navy); }
  .ct-info-list small { display: block; margin-top: 2px; font-size: 0.8rem; color: var(--text); }

  .ct-steps-card { position: relative; padding: 1.8rem; background: linear-gradient(140deg, #151c26 0%, #1c2532 60%, #f5a623 100%); box-shadow: 0 18px 40px rgba(0,0,0,0.66); }
  .ct-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.1rem; position: relative; }
  .ct-steps::before { content: ''; position: absolute; left: 17px; top: 18px; bottom: 18px; border-left: 2px dashed rgba(255,255,255,0.25); }
  .ct-steps li { position: relative; display: flex; align-items: flex-start; gap: 14px; }
  .ct-step-num { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #161d27; color: var(--blue); font-size: 0.92rem; font-weight: 800; box-shadow: 0 0 0 5px rgba(255,255,255,0.12); }
  .ct-steps strong { display: block; font-size: 0.95rem; color: #fff; }
  .ct-steps small { display: block; margin-top: 2px; font-size: 0.82rem; line-height: 1.5; color: rgba(255,255,255,0.75); }

