</style>

<script is:inline define:vars={{ waNumber: company.whatsapp, emailTo: company.email }}>
  (function () {
    function init() {
      var form = document.getElementById('ctForm');
      if (!form) return;
      var success = document.getElementById('ctSuccess');
      var channel = document.getElementById('ctChannel');
      var emailBtn = document.getElementById('ctEmailBtn');
      var resetBtn = document.getElementById('ctReset');
      var msg = document.getElementById('ct-message');
      var count = document.getElementById('ctCount');

      msg.addEventListener('input', function () { count.textContent = msg.value.length; });

      function fieldOf(el) { return el.closest('.ct-field'); }

      function validate() {
        var ok = true;
        form.querySelectorAll('.ct-field').forEach(function (f) { f.classList.remove('has-error'); });

        ['ct-name', 'ct-phone', 'ct-message'].forEach(function (id) {
          var el = document.getElementById(id);
          if (!el.value.trim() || !el.checkValidity()) { fieldOf(el).classList.add('has-error'); ok = false; }
        });
        var email = document.getElementById('ct-email');
        if (email.value.trim() && !email.checkValidity()) { fieldOf(email).classList.add('has-error'); ok = false; }

        var service = form.querySelector('input[name="service"]:checked');
        if (!service) { fieldOf(form.querySelector('input[name="service"]')).classList.add('has-error'); ok = false; }

        if (!ok) {
          var first = form.querySelector('.has-error');
          if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return ok;
      }

      function compose() {
        var d = new FormData(form);
        var lines = [
          'New project enquiry — Gallop Construction website',
          '',
          'Name: ' + (d.get('name') || ''),
          'Phone: ' + (d.get('phone') || ''),
        ];
        if (d.get('email')) lines.push('Email: ' + d.get('email'));
        if (d.get('location')) lines.push('Location: ' + d.get('location'));
        lines.push('Service: ' + (d.get('service') || ''));
        lines.push('', 'Details:', (d.get('message') || ''));
        return lines.join('\n');
      }

      function done(via) {
        channel.textContent = via;
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!validate()) return;
        window.open('https://wa.me/' + waNumber + '?text=' + encodeURIComponent(compose()), '_blank', 'noopener');
        done('WhatsApp');
      });

      emailBtn.addEventListener('click', function () {
        if (!validate()) return;
        var subject = 'Project Enquiry — ' + (new FormData(form).get('service') || 'Gallop Construction');
        window.location.href = 'mailto:' + emailTo + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(compose());
        done('your email app');
      });

      resetBtn.addEventListener('click', function () {
        form.reset();
        count.textContent = '0';
        success.hidden = true;
        form.hidden = false;
      });

      // Error hata do jab user likhna shuru kare
      form.addEventListener('input', function (e) {
        var f = fieldOf(e.target);
        if (f) f.classList.remove('has-error');
      });
      form.addEventListener('change', function (e) {
        var f = fieldOf(e.target);
        if (f) f.classList.remove('has-error');
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>