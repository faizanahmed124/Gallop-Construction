---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';

const stats = [
  { value: "10+",  label: "Years of Experience" },
  { value: "50+",  label: "Projects Completed" },
  { value: "3",    label: "Core Service Lines" },
  { value: "100%", label: "Safety Focused" },
];

const values = [
  { title: "Professionalism", desc: "Clear planning, organised sites and proper documentation on every project — from first meeting to final handover.",
    icon: `<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/>` },
  { title: "Integrity", desc: "Honest advice, transparent pricing and no hidden costs. We tell you what your project really needs.",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>` },
  { title: "Safety First", desc: "Every worker goes home safe. Proper PPE, trained supervisors and safety checks are non-negotiable on our sites.",
    icon: `<path d="M3 17h18M5 17v-3a7 7 0 0 1 14 0v3M10 7V5h4v2"/>` },
  { title: "Quality", desc: "Tested materials, skilled trades and inspections at every stage so the work lasts for decades, not years.",
    icon: `<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>` },
];

const commitments = [
  { icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`, label: "Safety Compliance", desc: "HSE procedures followed on every site, every day." },
  { icon: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>`, label: "On-Time Delivery", desc: "Realistic schedules that we plan, track and meet." },
  { icon: `<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c2.9.3 5 2.7 5 5.8"/>`, label: "Skilled Workforce", desc: "Trained engineers, supervisors and tradespeople." },
  { icon: `<polyline points="20 6 9 17 4 12"/>`, label: "Quality Assurance", desc: "Inspections and sign-offs at each project stage." },
  { icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>`, label: "Modern Equipment", desc: "Well-maintained tools and machinery for precise work." },
  { icon: `<path d="M11 14h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.8-2.8l-4.2 3.9"/><path d="m2 15 6 6"/>`, label: "Client Partnership", desc: "Long-term relationships built on trust and results." },
];

// Sirf wo registrations rakhein jo Gallop Construction ke paas waqai hain
const registrations = [
  { abbr: "FBR",   name: "Federal Board of Revenue",     detail: "National Tax Number (NTN) registered", type: "Federal" },
  { abbr: "PRA",   name: "Punjab Revenue Authority",     detail: "Sales Tax on Services registered",     type: "Provincial" },
  { abbr: "EOBI",  name: "Employees Old-Age Benefits",   detail: "Registered employer",                  type: "Labour" },
  { abbr: "PESSI", name: "Punjab Employees Social Security", detail: "Employee social security compliant", type: "Welfare" },
];
---

<Layout title="About - Gallop Construction" description="About Gallop Construction — civil, mechanical and insulation contractors">
  <Navbar />

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <div class="ab">

    <!-- ══ HERO ══ -->
    <section class="ab-hero">
      <div class="ab-hero-bg" aria-hidden="true">
        <div class="ab-hero-grid"></div>
        <div class="ab-orb ab-orb-1"></div>
        <div class="ab-orb ab-orb-2"></div>
      </div>

      <div class="ab-hero-inner">
        <span class="ab-badge"><span class="ab-bdot"></span> About Us <span class="ab-bdot"></span></span>
        <h1 class="ab-hero-title">
          Building Trust,<br /><span class="ab-hero-em">One Project at a Time</span>
        </h1>
        <p class="ab-hero-sub">
          Gallop Construction is a full-service contractor for civil works, mechanical fabrication,
          insulation and ducting — delivering safe, high-quality projects for homes, businesses and industry.
        </p>
        <nav class="ab-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          <span>About Us</span>
        </nav>
      </div>
    </section>

    <!-- ══ STATS (hero ke upar overlap) ══ -->
    <div class="ab-wrap">
      <div class="ab-stats" data-reveal>
        {stats.map(s => (
          <div class="ab-stat">
            <span class="ab-stat-val">{s.value}</span>
            <span class="ab-stat-lbl">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- ══ WHO WE ARE ══ -->
    <section class="ab-sec">
      <div class="ab-wrap ab-split">
        <div class="ab-mosaic" data-reveal>
          <div class="ab-m-main">
            <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=900&q=80" alt="Construction site" loading="lazy" />
          </div>
          <div class="ab-m-small ab-m-1">
            <img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=500&q=80" alt="Engineering work" loading="lazy" />
          </div>
          <div class="ab-m-small ab-m-2">
            <img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=500&q=80" alt="Fabrication work" loading="lazy" />
          </div>
          <div class="ab-m-badge">
            <span class="ab-m-badge-val">10+</span>
            <span class="ab-m-badge-lbl">Years of<br />Experience</span>
          </div>
        </div>

        <div class="ab-text" data-reveal>
          <span class="ab-eyebrow"><span class="ab-eyebrow-line"></span>Who We Are</span>
          <h2 class="ab-title">A Construction Partner You Can <span class="ab-accent">Rely On</span></h2>
          <p class="ab-body">
            Gallop Construction brings civil, mechanical and insulation work under one roof. Instead of
            juggling separate contractors, our clients get one experienced team, one schedule and one
            point of responsibility — from excavation and RCC structures to tank fabrication, pipeline
            insulation and final finishing.
          </p>
          <p class="ab-body">
            We work with homeowners, businesses and industrial plants, and we treat every project the
            same way: plan it properly, build it safely and hand it over on time.
          </p>
          <ul class="ab-checks">
            {["Residential, Commercial & Industrial Works",
              "Turnkey Project Management",
              "Quality Materials & Skilled Workforce",
              "Strict Safety Standards on Every Site"].map(item => (
              <li>
                <span class="ab-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ══ MISSION & VISION ══ -->
    <section class="ab-sec ab-alt">
      <div class="ab-wrap">
        <div class="ab-head" data-reveal>
          <span class="ab-eyebrow"><span class="ab-eyebrow-line"></span>Our Purpose<span class="ab-eyebrow-line"></span></span>
          <h2 class="ab-title">Mission &amp; <span class="ab-accent">Vision</span></h2>
        </div>
        <div class="ab-mv">
          <div class="ab-mv-card" data-reveal>
            <div class="ab-mv-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>
            </div>
            <span class="ab-mv-label">Our Mission</span>
            <h3 class="ab-mv-title">Delivering Excellence on Every Project</h3>
            <p class="ab-mv-desc">
              To deliver residential, commercial and industrial projects of the highest quality —
              safely, on time and within budget — while building lasting relationships with every client.
            </p>
          </div>
          <div class="ab-mv-card ab-mv-dark" data-reveal>
            <div class="ab-mv-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <span class="ab-mv-label">Our Vision</span>
            <h3 class="ab-mv-title">The Most Trusted Name in Construction</h3>
            <p class="ab-mv-desc">
              To be known for modern methods, a skilled workforce and structures that set new standards
              in every city we build — and to keep improving with every project we complete.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ VALUES ══ -->
    <section class="ab-sec">
      <div class="ab-wrap">
        <div class="ab-head" data-reveal>
          <span class="ab-eyebrow"><span class="ab-eyebrow-line"></span>What Drives Us<span class="ab-eyebrow-line"></span></span>
          <h2 class="ab-title">Our Core <span class="ab-accent">Values</span></h2>
        </div>
        <div class="ab-values">
          {values.map((v, i) => (
            <div class="ab-value" data-reveal style={`--d:${i * 90}ms`}>
              <span class="ab-value-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="ab-value-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={v.icon}></svg>
              </div>
              <h3 class="ab-value-title">{v.title}</h3>
              <p class="ab-value-desc">{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ QUALITY ══ -->
    <section class="ab-sec ab-alt">
      <div class="ab-wrap ab-split">
        <div class="ab-text" data-reveal>
          <span class="ab-eyebrow"><span class="ab-eyebrow-line"></span>Approach to Quality</span>
          <h2 class="ab-title">Quality Is a <span class="ab-accent">Culture</span>, Not a Checklist</h2>
          <p class="ab-body">
            At Gallop, quality is built into every stage — from choosing materials to the final
            inspection. Our supervisors check work as it happens, not after it's finished, so problems
            are caught early and fixed properly.
          </p>
          <p class="ab-body">
            We keep upgrading our methods, equipment and training so every new project is better
            than the last.
          </p>
          <div class="ab-qbadges">
            {["Tested Materials", "Skilled Technicians", "Stage-wise Inspections", "Proper Documentation"].map(b => (
              <span class="ab-qbadge">{b}</span>
            ))}
          </div>
        </div>

        <div class="ab-qvisual" data-reveal>
          <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=900&q=80" alt="Quality fabrication work" loading="lazy" />
          <div class="ab-qcard">
            <span class="ab-qcard-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <span><strong>Quality Guaranteed</strong><br />Checked at every stage</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ COMMITMENTS ══ -->
    <section class="ab-sec">
      <div class="ab-wrap">
        <div class="ab-head" data-reveal>
          <span class="ab-eyebrow"><span class="ab-eyebrow-line"></span>Our Promise<span class="ab-eyebrow-line"></span></span>
          <h2 class="ab-title">Six <span class="ab-accent">Commitments</span> on Every Project</h2>
        </div>
        <div class="ab-commits">
          {commitments.map((c, i) => (
            <div class="ab-commit" data-reveal style={`--d:${i * 70}ms`}>
              <div class="ab-commit-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon}></svg>
              </div>
              <div>
                <h4 class="ab-commit-title">{c.label}</h4>
                <p class="ab-commit-desc">{c.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ REGISTRATIONS ══ -->
    <section class="ab-sec ab-alt">
      <div class="ab-wrap">
        <div class="ab-head" data-reveal>
          <span class="ab-eyebrow"><span class="ab-eyebrow-line"></span>Official Credentials<span class="ab-eyebrow-line"></span></span>
          <h2 class="ab-title">Registered &amp; <span class="ab-accent">Compliant</span></h2>
          <p class="ab-head-sub">A fully registered business operating under all applicable regulations.</p>
        </div>
        <div class="ab-regs">
          {registrations.map((r, i) => (
            <div class="ab-reg" data-reveal style={`--d:${i * 80}ms`}>
              <span class="ab-reg-type">{r.type}</span>
              <div class="ab-reg-seal">{r.abbr}</div>
              <h4 class="ab-reg-name">{r.name}</h4>
              <p class="ab-reg-detail">{r.detail}</p>
              <span class="ab-reg-ok">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Verified &amp; Active
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ CTA ══ -->
    <section class="ab-cta-sec">
      <div class="ab-wrap">
        <div class="ab-cta" data-reveal>
          <div class="ab-cta-glow" aria-hidden="true"></div>
          <h2 class="ab-cta-title">Ready to Build with <span>Gallop Construction?</span></h2>
          <p class="ab-cta-sub">Get a free consultation and a detailed quote for your next project.</p>
          <div class="ab-cta-btns">
            <a href="/contact" class="ab-btn-solid">
              Contact Us
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/services" class="ab-btn-outline">View Services</a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Footer />
  <ScrollUpButton />
</Layout>

<style>
  .ab {
    --blue: #1d6ff2;
    --blue-light: #60a5fa;
    --blue-soft: #eaf2ff;
    --navy: #0f2a5c;
    --text: #5b6b85;
    --line: #e2eaf6;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: var(--navy);
    background: #fff;
  }
  .ab-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

  /* ── Hero ── */
  .ab-hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: linear-gradient(160deg, #071a3a 0%, #0f2a5c 55%, #123a80 100%);
    padding: 10rem 1.5rem 9rem;
    text-align: center;
  }
  .ab-hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .ab-hero-grid {
    position: absolute; inset: -60px;
    background-image:
      linear-gradient(rgba(96,165,250,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96,165,250,0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    animation: abGrid 20s linear infinite;
  }
  @keyframes abGrid { to { transform: translate(60px, 60px); } }
  .ab-orb { position: absolute; border-radius: 50%; filter: blur(100px); animation: abOrb 16s ease-in-out infinite alternate; }
  .ab-orb-1 { width: 480px; height: 480px; background: rgba(29,111,242,0.45); top: -180px; left: -120px; }
  .ab-orb-2 { width: 400px; height: 400px; background: rgba(14,165,233,0.30); bottom: -180px; right: -100px; animation-delay: -8s; }
  @keyframes abOrb { to { transform: translate(70px, 50px) scale(1.1); } }

  .ab-hero-inner { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.3rem; animation: abUp 0.9s cubic-bezier(.22,1,.36,1) both; }
  @keyframes abUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  .ab-badge {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: #fff; border: 1px solid rgba(96,165,250,0.45); border-radius: 999px;
    padding: 7px 18px; background: rgba(59,130,246,0.16);
  }
  .ab-bdot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-light); box-shadow: 0 0 8px var(--blue-light); animation: abPulse 1.8s ease infinite; }
  @keyframes abPulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }
  .ab-hero-title { margin: 0; font-size: clamp(2.4rem, 5.5vw, 4.4rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: #fff !important; }
  .ab-hero-em { color: var(--blue-light) !important; }
  .ab-hero-sub { margin: 0; max-width: 640px; font-size: clamp(0.95rem, 1.4vw, 1.08rem); line-height: 1.8; color: rgba(255,255,255,0.78); }
  .ab-crumbs { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 999px; background: rgba(255,255,255,0.08); font-size: 0.85rem; color: rgba(255,255,255,0.75); }
  .ab-crumbs a { color: #fff; text-decoration: none; font-weight: 600; }
  .ab-crumbs a:hover { color: var(--blue-light); }
  .ab-crumbs svg { width: 14px; height: 14px; }

  /* ── Stats (overlap) ── */
  .ab-stats {
    position: relative; z-index: 2;
    margin-top: -60px;
    display: grid; grid-template-columns: repeat(4, 1fr);
    background: #fff;
    border-radius: 22px;
    box-shadow: 0 24px 50px rgba(15,42,92,0.14);
    padding: 1.8rem 0.5rem;
  }
  .ab-stat { display: flex; flex-direction: column; align-items: center; gap: 6px; border-right: 1px solid var(--line); }
  .ab-stat:last-child { border-right: none; }
  .ab-stat-val { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 800; line-height: 1; color: var(--blue); }
  .ab-stat-lbl { font-size: 0.8rem; font-weight: 600; color: var(--text); text-align: center; }

  /* ── Sections ── */
  .ab-sec { padding: 6rem 0; }
  .ab-alt { background: linear-gradient(180deg, #f3f7fd 0%, #f8fbff 100%); }
  .ab-split { display: grid; grid-template-columns: 1fr 1fr; gap: 4.5rem; align-items: center; }

  .ab-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 0.9rem;
  }
  .ab-eyebrow-line { width: 30px; height: 3px; border-radius: 2px; background: var(--blue); }
  .ab-title { margin: 0 0 1.2rem; font-size: clamp(1.9rem, 3.6vw, 2.8rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--navy) !important; }
  .ab-accent { color: var(--blue) !important; }
  .ab-body { margin: 0 0 1rem; font-size: 1rem; line-height: 1.8; color: var(--text); }
  .ab-head { text-align: center; max-width: 720px; margin: 0 auto 3.2rem; }
  .ab-head-sub { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--text); }

  .ab-checks { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 1.2rem; }
  .ab-checks li { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 600; color: var(--navy); }
  .ab-check { flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--blue-soft); color: var(--blue); }
  .ab-check svg { width: 12px; height: 12px; }

  /* Mosaic */
  .ab-mosaic { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 230px 230px; gap: 1rem; }
  .ab-mosaic img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(.22,1,.36,1); }
  .ab-m-main, .ab-m-small { border-radius: 20px; overflow: hidden; box-shadow: 0 18px 40px rgba(15,42,92,0.14); }
  .ab-m-main { grid-row: 1 / 3; }
  .ab-m-main:hover img, .ab-m-small:hover img { transform: scale(1.06); }
  .ab-m-badge {
    position: absolute; left: -1.2rem; bottom: 2rem;
    display: flex; align-items: center; gap: 12px;
    padding: 1rem 1.3rem; border-radius: 16px;
    background: linear-gradient(150deg, #2b7cff, #1257d6); color: #fff;
    box-shadow: 0 16px 34px rgba(29,111,242,0.35);
    animation: abBob 5s ease-in-out infinite;
  }
  @keyframes abBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  .ab-m-badge-val { font-size: 2.1rem; font-weight: 800; line-height: 1; }
  .ab-m-badge-lbl { font-size: 0.78rem; font-weight: 600; line-height: 1.3; opacity: 0.92; }

  /* Mission / Vision */
  .ab-mv { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .ab-mv-card {
    position: relative; overflow: hidden;
    padding: 2.6rem 2.4rem;
    background: #fff; border: 1px solid var(--line); border-radius: 24px;
    box-shadow: 0 12px 32px rgba(15,42,92,0.06);
    transition: transform 0.35s cubic-bezier(.22,1,.36,1), box-shadow 0.35s;
  }
